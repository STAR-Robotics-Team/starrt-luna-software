#!/usr/bin/env python3
"""Keeps the design docs' shared tables in registries, and checks that they fit together.

Each design doc has a registry beside it, docs/design/<doc>.toml, that holds its software
elements, nodes, and open questions. Each node defines the topics it publishes and the
services and actions it serves, so every interface lives with its only publisher or
server; a topic many nodes publish by design is a [[shared]] entry instead. A doc shows
them in tables that this script writes between two markers:

    <!-- design: interfaces -->
    (the generated table)
    <!-- /design -->

It also writes pages built from every registry: docs/design/interfaces.md (every node and
interface), docs/design/performance-budgets.md (every technical performance measure, its
budget, and its measurements, from performance-budgets.toml), docs/design/end-to-end-tests.md
(the end-to-end test procedures), and docs/design/open-items.md (every open question, and
every [TBD] and [TBR] marker in the docs).

The end-to-end test procedures, and their runs, live in the test sheet: a Google Sheet,
one tab per procedure (the [[sheet]] in end-to-end-tests.toml). The pages read it live in
the browser; this script reads it too, to check it against the registries.

    scripts/design render       Rewrite every generated table and page. Offline.
    scripts/design check        Check the registries, that every generated table and page is
                                up to date, and that the test sheet names only what the
                                registries define. CI runs it on every pull request.
    scripts/design sheet-json   Print the test sheet as this script reads it, as JSON.

Needs only Python 3.11 or newer. See "Registries" in docs/design/README.md.
"""
import argparse
import re
import sys
import tomllib
import unicodedata
from datetime import date
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
DOCS = REPO / "docs"
DESIGN = DOCS / "design"
INTERFACES_PAGE = DESIGN / "interfaces.md"
OPEN_ITEMS_PAGE = DESIGN / "open-items.md"
BUDGETS_PAGE = DESIGN / "performance-budgets.md"
PROCEDURES_PAGE = DESIGN / "end-to-end-tests.md"
MODES_PAGE = DESIGN / "hardware-test-modes.md"
LAYERS = ("Sim", "Bench", "Robot")
TEMPLATE = DESIGN / "template.md"
# Pages generated from other data, which the open items scan skips.
GENERATED_PAGES = {INTERFACES_PAGE, OPEN_ITEMS_PAGE, BUDGETS_PAGE, PROCEDURES_PAGE, DOCS / "sources.md"}
# Pages that show markers as examples of how to write them.
EXAMPLE_PAGES = {DOCS / "writing-docs.md"}
# Docs listed first, in this order; the rest follow alphabetically.
DOC_ORDER = ["system", "operating-modes"]

IFACE = [
