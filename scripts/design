# Tables written under an entry: (parent kind, key) -> schema name.
SUBTABLES = {"row": "tpm.row"}


def fields(table):
    """(required, optional) field names of one kind of entry."""
    entries = SCHEMA[table][1]
    return [f for f, req, _ in entries if req], [f for f, req, _ in entries if not req]


# The interfaces a node defines, under it, and the kind each one is.
NESTED = {"publishes": "topic", "serves": "service", "serves_actions": "action"}
FIELDS = {t: fields(t) for t in ("element", "node", "shared", "question", "tpm", "sheet")}
FIELDS["node"][1].extend(NESTED)
FIELDS["tpm"][1].append("row")
LISTS = {"subscribes", "calls", "publishes_shared", "turgor", "elements", "cases", "notes"}
NUMBERS = {"limit", "amount", "threshold_value", "goal_value"}
TURGOR = re.compile(r"\d+\.\d+")

START = re.compile(r"<!-- design: ([a-z]+)((?: [a-z]+)*)(?: \([^)]*\))? -->")
END = "<!-- /design -->"
# Each block a doc can hold: (its options, what it shows). The README's list is generated
# from this.
BLOCK_HELP = {
    "nodes": (["connected"], "The nodes in this doc's registry. With `connected`, also every node that publishes or subscribes to this doc's interfaces, with its design doc."),
    "interfaces": ([], "The topics, services, and actions this doc's nodes define, then the ones they use from other docs"),
    "questions": ([], "This doc's open and decided questions"),
    "budgets": ([], "Every budget row in `performance-budgets.toml` that names one of this doc's elements"),
    "elements": ([], "Every software element"),
    "graph": ([], "A diagram of every node, with an arrow for each topic and call"),
    "fields": ([], "This reference of registry fields"),
    "blocks": ([], "This list of blocks"),
}
BLOCKS = {kind: options for kind, (options, _) in BLOCK_HELP.items()}
# Blocks that show the doc's own registry, so the doc needs one beside it.
OWN_REGISTRY = {"nodes", "interfaces", "questions", "budgets"}
NOTE = "generated from {registry} by scripts/design render: edit that file, not this table"


class Problems:
    """Collects errors and warnings so a check can report all of them at once."""

    def __init__(self):
        self.errors = []
        self.warnings = []

    def error(self, message):
        self.errors.append(message)

    def warn(self, message):
        self.warnings.append(message)

    def report(self):
        for message in self.warnings:
            print(f"warning: {message}", file=sys.stderr)
        for message in self.errors:
            print(f"error: {message}", file=sys.stderr)
        return 1 if self.errors else 0


# ----------------------------------------------------------------------------------------
# Registries
# ----------------------------------------------------------------------------------------

class Registry:
    """Every registry's entries, keyed for lookup, and where each one is defined."""

    def __init__(self):
        self.elements = {}    # id -> entry
        self.nodes = {}       # id -> entry
        self.interfaces = {}  # id -> entry
        self.owner = {}       # id(interface) -> id of the node that publishes or serves it
        self.questions = {}   # doc stem -> [entries]
        self.tpms = []        # entries, in order
        self.sheet = None     # the test sheet, if one is set
        self.test_modes = {}  # system -> its test modes, from hardware-test-modes.md
        self.home = {}        # id(entry) -> doc stem of the registry that defines it

    def doc_of(self, entry):
        return self.home[id(entry)]

    def publishers(self, iface):
        if iface.get("shared"):
            return [n for n in self.nodes.values() if iface["id"] in n.get("publishes_shared", [])]
        return [self.nodes[self.owner[id(iface)]]]

    def subscribers(self, iface):
        verb = "subscribes" if iface["kind"] == "topic" else "calls"
        return [n for n in self.nodes.values() if iface["id"] in n.get(verb, [])]


def registry_files():
    return sorted(DESIGN.glob("*.toml"), key=doc_sort_key)


def doc_sort_key(path):
    stem = path.stem
    return (DOC_ORDER.index(stem) if stem in DOC_ORDER else len(DOC_ORDER), stem)


def check_value(problems, where, key, value):
    if key in LISTS:
        if not isinstance(value, list) or not all(isinstance(v, str) for v in value):
            problems.error(f"{where}: {key} must be a list of strings")
            return
        values = value
    elif key in NUMBERS:
        if not isinstance(value, (int, float)) or isinstance(value, bool):
            problems.error(f"{where}: {key} must be a number")
        return
    elif key == "amounts":
        if not isinstance(value, list) or not all(isinstance(v, (int, float)) for v in value):
            problems.error(f"{where}: amounts must be a list of numbers")
        return
    elif key in SUBTABLES:
        name = SUBTABLES[key]
        if not isinstance(value, list) or not all(isinstance(v, dict) for v in value):
            problems.error(f"{where}: {key} must be [[{name}]] entries")
            return
        for n, row in enumerate(value, 1):
            check_entry(problems, f"{where}, {key} {n}", row, *fields(name))
        return
    elif key in NESTED:
        if not isinstance(value, list) or not all(isinstance(v, dict) for v in value):
            problems.error(f"{where}: {key} must be [[node.{key}]] entries, one per interface")
        return
    elif key == "number":
        if not isinstance(value, int):
            problems.error(f"{where}: number must be a whole number")
        return
    elif key in ("decided", "date"):
        if not isinstance(value, date):
            problems.error(f"{where}: {key} must be a date, such as 2026-10-27")
        return
    else:
        if not isinstance(value, str) or not value.strip():
            problems.error(f"{where}: {key} must be text")
            return
        values = [value]
    for v in values:
        if "|" in v or "\n" in v:
            problems.error(f"{where}: {key} may not contain | or a line break, which would break the table")
        if v.count("[") != v.count("]"):
            problems.error(f"{where}: {key} has unbalanced brackets: {v!r}")


def check_entry(problems, where, entry, required, optional):
    for key in required:
        if key not in entry:
            problems.error(f"{where} has no {key}")
    for key, value in entry.items():
        if key not in required and key not in optional:
            problems.error(f"{where} has an unknown field {key!r}")
        else:
            check_value(problems, where, key, value)


def add_interface(problems, reg, where, stem, entry):
    entry.setdefault("id", entry.get("name", ""))
    reg.home[id(entry)] = stem
    key = entry["id"]
    if key in reg.interfaces:
        problems.error(f"{where}: {key!r} is also defined in {reg.doc_of(reg.interfaces[key])}.toml. "
                       "Only one node publishes or serves an interface; others subscribe to it or call it.")
    reg.interfaces[key] = entry


def load(problems):
    reg = Registry()
    for path in registry_files():
        stem = path.stem
        try:
            with path.open("rb") as f:
                data = tomllib.load(f)
        except tomllib.TOMLDecodeError as e:
            problems.error(f"{path.name}: {e}")
            continue
        for table in data:
            if table not in FIELDS:
                problems.error(f"{path.name}: unknown table [[{table}]]; use {', '.join(FIELDS)}")
        for kind, (required, optional) in FIELDS.items():
            for n, entry in enumerate(data.get(kind, []), 1):
                label = entry.get("id") or entry.get("name") or entry.get("number") or n
                where = f"{path.name}: {kind} {label}"
                check_entry(problems, where, entry, required, optional)
                reg.home[id(entry)] = stem
                if kind == "shared":
                    entry["kind"], entry["shared"] = "topic", True
                    add_interface(problems, reg, where, stem, entry)
                    continue
                if kind == "node":
                    for verb, iface_kind in NESTED.items():
                        subs = entry.get(verb, [])
                        for sub in subs if isinstance(subs, list) else []:
                            if not isinstance(sub, dict):
                                continue
                            sub_where = f"{where} {verb} {sub.get('id') or sub.get('name')}"
                            if "kind" in sub:
                                sub.pop("kind")
                                problems.error(f"{sub_where} has a kind, but the table says it: "
                                               "[[node.publishes]] holds topics, [[node.serves]] services, "
                                               "and [[node.serves_actions]] actions")
                            check_entry(problems, sub_where, sub, *fields(f"node.{verb}"))
                            sub["kind"] = iface_kind
                            reg.owner[id(sub)] = entry.get("id")
                            add_interface(problems, reg, sub_where, stem, sub)
                if kind == "question":
                    reg.questions.setdefault(stem, []).append(entry)
                    continue
                if kind == "tpm":
                    reg.tpms.append(entry)
                    continue
                if kind == "sheet":
                    if reg.sheet is not None:
                        problems.error(f"{where}: there is one test sheet; this is a second [[sheet]]")
                    reg.sheet = entry
                    continue
                store = {"element": reg.elements, "node": reg.nodes}[kind]
                key = entry.get("id", "")
                if key in store:
                    problems.error(f"{where}: {kind} {key!r} is also defined in {reg.doc_of(store[key])}.toml")
                store[key] = entry
    reg.test_modes = load_test_modes(problems)
    return reg


def validate(problems, reg):
    for e in reg.elements.values():
        where = f"{reg.doc_of(e)}.toml: element {e['id']}"
        if e.get("parent") and e["parent"] not in reg.elements:
            problems.error(f"{where}: no element {e['parent']!r} for its parent")
        doc = e.get("doc", "")
        if not re.fullmatch(r"[a-z0-9-]+\.md", doc):
            problems.error(f"{where}: doc must be a design doc's file name, such as drivetrain.md")
        elif not (DESIGN / doc).exists() and not (DESIGN / doc).with_suffix(".toml").exists():
            problems.error(f"{where}: no {doc} or {Path(doc).stem}.toml in docs/design")
        for t in e.get("turgor", []):
            if not TURGOR.fullmatch(t):
                problems.error(f"{where}: turgor holds deliverable numbers, such as 3.1, not {t!r}")
    for n in reg.nodes.values():
        where = f"{reg.doc_of(n)}.toml: node {n['id']}"
        if n.get("element") not in reg.elements:
            problems.error(f"{where}: no element {n.get('element')!r}")
        for verb, kinds, defined_under in (("subscribes", ("topic",), "[[node.publishes]]"),
                                           ("calls", ("service", "action"),
                                            "[[node.serves]] or [[node.serves_actions]]")):
            for ref in n.get(verb, []):
                iface = reg.interfaces.get(ref)
                if iface is None:
                    problems.error(f"{where} {verb} {ref!r}, which no registry defines. The node that "
                                   f"{'publishes' if verb == 'subscribes' else 'serves'} it defines it, "
                                   f"under {defined_under} in its own registry.")
                elif iface.get("kind") not in kinds:
                    problems.error(f"{where} {verb} {ref!r}, which is a {iface.get('kind')}: "
                                   f"a node {verb} only a {' or '.join(kinds)}")
        for ref in n.get("publishes_shared", []):
            iface = reg.interfaces.get(ref)
            if iface is None or not iface.get("shared"):
                whose = f", which {reg.owner[id(iface)]} publishes" if iface else ""
                problems.error(f"{where} lists {ref!r} under publishes_shared{whose}. publishes_shared "
                               "is for a topic many nodes publish by design, defined as a [[shared]] entry; "
                               "a topic with one publisher is defined under that node's [[node.publishes]].")
    for i in reg.interfaces.values():
        where = f"{reg.doc_of(i)}.toml: {'shared topic' if i.get('shared') else 'interface'} {i['id']}"
        if i.get("shared") and not reg.publishers(i):
            problems.error(f"{where}: no node publishes it; list it under a node's publishes_shared")
        if not reg.subscribers(i):
            problems.warn(f"{where}: nothing uses it yet")
    seen = set()
    for tpm in reg.tpms:
        where = f"{reg.doc_of(tpm)}.toml: {tpm.get('id')}"
        if tpm.get("id") in seen:
            problems.error(f"{where} appears twice")
        seen.add(tpm.get("id"))
        cases = tpm.get("cases", [])
        for n, row in enumerate(tpm.get("row", []), 1):
            for e in row.get("elements", []):
                if e not in reg.elements:
                    problems.error(f"{where}, row {n}: no element {e!r}")
            if cases:
                if len(row.get("amounts", [])) != len(cases):
                    problems.error(f"{where}, row {n}: give amounts, one for each of the {len(cases)} cases")
            elif "value" not in row:
                problems.error(f"{where}, row {n} has no value")
        for case, total, limit, _ in budget_totals(tpm):
            if limit is not None and total > limit:
                label = f" in {case}" if case else ""
                problems.error(f"{where}: its parts{label} add up to {number(total)}, over its limit of {number(limit)}")
    if reg.sheet:
        for key, start in (("edit_url", "https://docs.google.com/spreadsheets/d/"),
                           ("published", "https://docs.google.com/spreadsheets/d/e/")):
            if key in reg.sheet and not str(reg.sheet[key]).startswith(start):
                problems.error(f"end-to-end-tests.toml: the sheet's {key} must start with {start}")
    for tpm in reg.tpms:
        if ("threshold_value" in tpm or "goal_value" in tpm) and tpm.get("better") not in ("lower", "higher"):
            problems.error(f"{reg.doc_of(tpm)}.toml: {tpm.get('id')}: better must be lower or higher, "
                           "so a measurement can be judged against its values")
    for stem, questions in reg.questions.items():
        seen = set()
        for q in questions:
            where = f"{stem}.toml: question {q.get('number')}"
            if q.get("number") in seen:
                problems.error(f"{where} appears twice")
            seen.add(q.get("number"))
            status = q.get("status")
            if status not in ("open", "decided"):
                problems.error(f"{where}: status must be open or decided")
            elif status == "decided" and "decided" not in q:
                problems.error(f"{where}: a decided question needs the date it was decided")
            elif status == "open" and "decided" in q:
                problems.error(f"{where}: an open question has no decided date")
            for t in q.get("turgor", []):
                if not TURGOR.fullmatch(t):
                    problems.error(f"{where}: turgor holds deliverable numbers, such as 5.7, not {t!r}")


# ----------------------------------------------------------------------------------------
# Rendering helpers
# ----------------------------------------------------------------------------------------

def table(header, rows):
    out = ["| " + " | ".join(header) + " |", "| " + " | ".join("---" for _ in header) + " |"]
    for row in rows:
        out.append("| " + " | ".join(cell or " " for cell in row) + " |")
    return out


def code(name):
    """Interface names in code font, unless they are not decided yet."""
    return name if "[" in name else f"`{name}`"


def doc_link(stem, reg=None):
    """A link to a design doc from another page in docs/design, or its file name when it
    is not written yet."""
    path = DESIGN / f"{stem}.md"
    if path.exists():
        return f"[{doc_title(path)}]({path.name})"
    deliverables = sorted({t for e in (reg.elements.values() if reg else []) if e["doc"] == f"{stem}.md"
                           for t in e.get("turgor", [])})
    when = f", not written yet ({', '.join(deliverables)})" if deliverables else ", not written yet"
    return f"`{stem}.md`{when}"


def doc_title(path):
    for line in path.read_text(encoding="utf-8").splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return path.stem


def element_key(element_id):
    """SW.1.10 after SW.1.9: the parts of an element's id, compared as numbers."""
    return [int(p) if p.isdigit() else -1 for p in element_id.split(".")]


def by_element(nodes):
    return sorted(nodes, key=lambda n: (element_key(n["element"]), n["name"]))


def element_label(reg, element_id):
    e = reg.elements.get(element_id)
    return f"{element_id} {e['name']}" if e else element_id


def nodes_of(reg, stem):
    return [n for n in reg.nodes.values() if reg.doc_of(n) == stem]


def interfaces_of(reg, stem):
    """Interfaces this doc defines, then the ones its nodes use from other docs."""
    own_nodes = nodes_of(reg, stem)
    used = set()
    for n in own_nodes:
        for verb in ("subscribes", "calls", "publishes_shared"):
            used.update(n.get(verb, []))
    defined = [i for i in reg.interfaces.values() if reg.doc_of(i) == stem]
    others = [i for i in reg.interfaces.values() if i["id"] in used and reg.doc_of(i) != stem]
    return defined + others


def names(nodes):
    return ", ".join(n["name"] for n in by_element(nodes))


def interface_rows(reg, interfaces, defined_in=False):
    rows = []
    for i in interfaces:
        row = [code(i["name"]), i["kind"], code(i["type"]), i["rate"],
               names(reg.publishers(i)), names(reg.subscribers(i)) or "None yet", i["qos"]]
        if defined_in:
            row.append(doc_link(reg.doc_of(i), reg=reg))
        rows.append(row)
    return rows


INTERFACE_HEADER = ["Name", "Kind", "Type", "Rate", "Publisher or server", "Subscriber or client", "QoS"]


# ----------------------------------------------------------------------------------------
# Blocks inside docs
# ----------------------------------------------------------------------------------------

def block_nodes(reg, stem, options):
    nodes = nodes_of(reg, stem)
    if "connected" in options:
        ids = {n["id"] for n in nodes}
        others = {}
        for i in interfaces_of(reg, stem):
            for n in reg.publishers(i) + reg.subscribers(i):
                if n["id"] not in ids:
                    others[n["id"]] = n
        nodes += by_element(others.values())
        rows = [[n["name"], n.get("package", "[TBD]"), n["runs_on"], element_label(reg, n["element"]),
                 doc_link(reg.doc_of(n), reg=reg), n["does"]] for n in nodes]
        return table(["Node", "Package", "Runs on", "Element", "Design doc", "What it does"], rows)
    rows = [[n["name"], n.get("package", "[TBD]"), n["runs_on"], element_label(reg, n["element"]), n["does"]]
            for n in nodes]
    return table(["Node", "Package", "Runs on", "Element", "What it does"], rows)


def block_interfaces(reg, stem, options):
    return table(INTERFACE_HEADER, interface_rows(reg, interfaces_of(reg, stem)))


def block_questions(reg, stem, options):
    rows = []
    for q in reg.questions.get(stem, []):
        status = "Open" if q["status"] == "open" else f"Decided {q['decided'].isoformat()}"
        rows.append([f"{q['number']}. {q['text']}", status, ", ".join(q.get("turgor", [])) or "None"])
    return table(["Question", "Status", "Turgor"], rows)


def block_elements(reg, stem, options):
    rows = []
    for e in sorted(reg.elements.values(), key=lambda e: element_key(e["id"])):
        rows.append([e["id"], e["name"], e["function"], e.get("connects_to", "None"),
                     doc_link(Path(e["doc"]).stem, reg=reg), ", ".join(e.get("turgor", [])) or "None"])
    return table(["ID", "Element", "Function", "Connects to (other teams' parts)", "Design doc", "Turgor"], rows)


def mermaid_text(text):
    """Mermaid cannot show markers or code font, so it gets plain words and a short tag."""
    tag = ""
    if "[TBD" in text:
        tag = " (TBD)"
    elif "[TBR" in text:
        tag = " (TBR)"
    bare = re.fullmatch(r"\[(?:TBD|TBR): ([^,\]]+)[^\]]*\]", text.strip())
    if bare:
        # A name that is only a marker, such as "[TBD: obstacle map topic, ...]".
        text = bare.group(1)
    text = re.sub(r"\s*\[(?:TBD|TBR)(?::[^\]]*)?\]", "", text)
    text = text.replace("`", "").replace('"', "#quot;").strip()
    return (text or "not named yet") + tag


def block_graph(reg, stem, options):
    """Every node, grouped by the computer it runs on, with an arrow per topic or call.
    Shared topics, such as /diagnostics, would add an arrow from nearly every node, so the
    text around the graph names them instead."""
    out = ["```mermaid", "flowchart LR"]
    ids = {}
    groups = {}
    for n in by_element(reg.nodes.values()):
        ids[n["id"]] = "n" + re.sub(r"[^A-Za-z0-9]", "_", n["id"])
        groups.setdefault(mermaid_text(n["runs_on"]), []).append(n)
    for g, (where, nodes) in enumerate(groups.items()):
        out.append(f'  subgraph g{g}["{where}"]')
        for n in nodes:
            out.append(f'    {ids[n["id"]]}["{mermaid_text(n["name"])}"]')
        out.append("  end")
    for i in reg.interfaces.values():
        if i.get("shared"):
            continue
        label = mermaid_text(i["name"])
        arrow = "-->" if i["kind"] == "topic" else "-.->"
        for p in reg.publishers(i):
            for s in reg.subscribers(i):
                if i["kind"] == "topic":
                    out.append(f'  {ids[p["id"]]} {arrow}|"{label}"| {ids[s["id"]]}')
                else:
                    out.append(f'  {ids[s["id"]]} {arrow}|"{label}"| {ids[p["id"]]}')
    out.append("```")
    return out


# ----------------------------------------------------------------------------------------
# Performance budgets
# ----------------------------------------------------------------------------------------

def number(n):
    """150 -> "150", 1000 -> "1,000", 11.5 -> "11.5"."""
    if isinstance(n, float) and n.is_integer():
        n = int(n)
    return f"{n:,}" if isinstance(n, int) else f"{n:,.2f}".rstrip("0").rstrip(".")


def unknown(row):
    """A part of the budget that is not decided yet, so the total cannot count it."""
    return "amount" not in row and "amounts" not in row and "[TBD" in row.get("value", "")


def counted(row):
    return "amount" in row or "amounts" in row


def budget_totals(tpm):
    """(case, total, limit, any part unknown) for each case, or one with case None."""
    rows = tpm.get("row", [])
    if not any(counted(r) for r in rows):
        return []
    limit = tpm.get("limit")
    if tpm.get("cases"):
        return [(case, sum(r["amounts"][i] for r in rows if len(r.get("amounts", [])) > i), limit, False)
                for i, case in enumerate(tpm["cases"])]
    return [(None, sum(r["amount"] for r in rows if "amount" in r), limit, any(unknown(r) for r in rows))]


def tpm_title(tpm):
    return f"{tpm['id']}: {tpm['measure'].split(' (')[0]}"


def tpm_link(tpm, page=""):
    return f"{page}#{slugify(tpm_title(tpm))}"


def budget_table(tpm):
    rows = tpm.get("row", [])
    cases = tpm.get("cases", [])
    has_unit = any("unit" in r for r in rows)
    has_basis = any("basis" in r for r in rows)
    header = [tpm.get("part", "Part"), tpm.get("elements_header", "Elements")]
    header += cases or [tpm.get("allocation", "Allocation")]
    header += ["Unit"] * has_unit + ["Basis"] * has_basis

    def cells(r):
        out = [r["part"], r.get("role") or ", ".join(r.get("elements", [])) or "None"]
        out += [number(a) for a in r.get("amounts", [])] if cases else [r.get("value", "")]
        return out + [r.get("unit", "")] * has_unit + [r.get("basis", "")] * has_basis

    totals = budget_totals(tpm)
    if not totals:
        return table(header, [cells(r) for r in rows])
    # Parts that add up come first, then the total, then rows the total does not count.
    before = [r for r in rows if counted(r) or unknown(r)]
    after = [r for r in rows if not (counted(r) or unknown(r))]
    total_cells = []
    for case, total, limit, missing in totals:
        text = f"**{number(total)}**"
        if limit is not None:
            text += f" of {number(limit)}, leaving {number(limit - total)}"
        if missing:
            text += ", not counting the parts still TBD"
        total_cells.append(text)
    units = {r.get("unit") for r in rows if counted(r)}
    total_row = [f"**{tpm.get('total_label', 'Total')}**", tpm.get("total_role", "")] + total_cells
    total_row += [units.pop() if len(units) == 1 and None not in units else ""] * has_unit + [""] * has_basis
    return table(header, [cells(r) for r in before] + [total_row] + [cells(r) for r in after])


def carries(reg):
    """{element id: set of TPM ids}: the TPMs each element's budgets name, and a parent
    carries what its children carry."""
    found = {e: set() for e in reg.elements}
    for tpm in reg.tpms:
        for r in tpm.get("row", []):
            for e in r.get("elements", []):
                found.setdefault(e, set()).add(tpm["id"])
    for e in sorted(reg.elements, key=element_key, reverse=True):
        parent = reg.elements[e].get("parent")
        if parent in found:
            found[parent] |= found[e]
    return found


def tpm_number(tpm_id):
    return int(tpm_id.split("-")[1]) if tpm_id.split("-")[-1].isdigit() else 0


def render_budgets_page(reg):
    out = [
        "# Performance budgets",
        "",
        "The technical performance measures (TPMs) the robot software is held to, and how each",
        "one is split across the software elements in the",
        "[system design](system.md#software-elements). Each TPM is one measurable quantity with",
        "one unit:",
        "",
        "- **Source** is the higher-level requirement it tracks: a TPM in the PMP's Table 3, and",
        "  the guidebook rule behind it. \"Derived\" means the PMP has no matching TPM, and the",
        "  measure protects the ones it names.",
        "- **Threshold** is the least acceptable value, and **goal** is the target, as in PMP",
        "  Table 3.",
        "- **Not allocated to software:** berm volume (software affects it only through TPM-1),",
        "  dimensions, and dust tolerance. They belong to the hardware.",
        "",
        "Each design doc shows its own elements' budgets in its Budgets table. To change a",
        "budget, edit `performance-budgets.toml` and run `scripts/design render`. The check",
        "fails when a budget's parts add up to more than its limit, and every margin and total",
        "here is computed, not typed.",
        "",
        "This page is generated from `docs/design/performance-budgets.toml` by",
        "`scripts/design render`.",
        "",
        "## Measures",
        "",
    ]
    rows = []
    for tpm in reg.tpms:
        budget = tpm.get("none") or f"[{tpm.get('budget', 'Budget')}]({tpm_link(tpm)})"
        # The procedures that measure it are in the test sheet, which the page reads live.
        by = f'<span class="test-sheet" data-view="measured-by" data-tpm="{tpm["id"]}"></span>'
        rows.append([tpm["id"], tpm["measure"], tpm["unit"], tpm["source"], tpm["threshold"], tpm["goal"], budget, by])
    out += table(["ID", "Measure", "Unit", "Source", "Threshold", "Goal", "Budget", "Measured by"], rows)
    out += ["", "## Measurements", "",
            "The latest value each TPM measured at each layer, from the runs in the",
            f"[test sheet]({PROCEDURES_PAGE.name}#recording-a-run), judged against its threshold and",
            "goal. This page reads the sheet each time it opens.", "", TEST_SHEET.format("measurements")]
    out += ["", "## Budgets"]
    for tpm in reg.tpms:
        if not tpm.get("row"):
            continue
        out += ["", f"### {tpm_title(tpm)}", "", f"{tpm.get('budget', 'Budget')}.", ""]
        out += budget_table(tpm)
        if tpm.get("notes"):
            out += [""] + [f"- {note}" for note in tpm["notes"]]
    out += ["", "## What each element carries", "",
            "The TPMs whose budgets name each element. A parent carries what its children carry,",
            "and every element also carries TPM-13 (0 kg).", ""]
    found = carries(reg)
    rows = [[f"{e} {reg.elements[e]['name']}", ", ".join(sorted(found[e], key=tpm_number)) or "None"]
            for e in sorted(reg.elements, key=element_key)]
    out += table(["Element", "TPMs"], rows)
    return "\n".join(out + ["", TEST_SHEET.format("data")]) + "\n"


def block_budgets(reg, stem, options):
    own = {eid for eid, e in reg.elements.items() if e["doc"] == f"{stem}.md"}
    rows = []
    for tpm in reg.tpms:
        for r in tpm.get("row", []):
            mine = [e for e in r.get("elements", []) if e in own]
            if not mine:
                continue
            unit = r.get("unit") or tpm.get("budget_unit", "")
            if tpm.get("cases"):
                budget = ", ".join(f"{number(a)} {unit} in {case}" for a, case in zip(r["amounts"], tpm["cases"]))
            else:
                value = r.get("value", "")
                budget = f"{value} {unit}" if unit and re.fullmatch(r"[≤≥]?[\d.,]+", value) else value
            part = r["part"] + (f" ({r['role']})" if r.get("role") else "")
            rows.append([f"[{tpm['id']}]({tpm_link(tpm, BUDGETS_PAGE.name)})", ", ".join(mine), part, budget])
    if not rows:
        rows = [["None", "", "", ""]]
    return table(["TPM", "Element", "Part", "Budget"], rows)


# ----------------------------------------------------------------------------------------
# The test sheet: end-to-end test procedures and their runs
# ----------------------------------------------------------------------------------------

# Testers write each end-to-end test procedure, and record its runs, in one tab of a Google
# Sheet (the [[sheet]] in end-to-end-tests.toml). A tab is a procedure when it has a
# header row that starts with "Row" and has a "What happens" column. Each row below the
# header is a Step, a Pass line, or a Measure, or one of the run rows: Layer, Date, and
# Log. Each run takes a Result column and the Note column beside it.
#
# The website reads the sheet in the reader's browser (docs/javascripts/test-sheet.js), and
# the build and the check read it here. Both readers turn the sheet into the same data,
# and scripts/test-sheet-readers.js checks that they agree on a sample sheet: change them
# together.
TEST_SHEET = "<!-- test-sheet: {} -->"
SHEET_COLUMNS = {"row": "kind", "do": "do", "pass when": "pass_when", "applies when": "applies",
                 "actor": "actor", "node": "node", "interface": "interface", "budget": "budget",
                 "measures": "measures"}
STEP_FIELDS = ("applies", "actor", "node", "do", "pass_when", "interface", "budget", "measures")
TEMPLATE_TAB = "Template"
MARKS = {"pass": "Pass", "fail": "Fail"}
# How a measured value compares with its TPM, and whether the step passes.
LEVELS = {"goal": "Pass", "threshold": "Pass", "recorded": "Pass", "missed": "Fail"}
XLSX = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
XLSX_RELS = "{http://schemas.openxmlformats.org/package/2006/relationships}"
XLSX_ID = "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id"
NUMBER = re.compile(r"[-+]?(?:[0-9]+\.?[0-9]*|\.[0-9]+)(?:[eE][-+]?[0-9]+)?")


def read_workbook(data):
    """[(tab name, {row: {column: value}})] from an .xlsx file's bytes, in tab order. Rows
    and columns count from 1. A value is text, or a number for a number cell."""
    import io
    import xml.etree.ElementTree as ET
    import zipfile
    book = zipfile.ZipFile(io.BytesIO(data))

    def part(name):
        return ET.fromstring(book.read(name))

    def words(item):
        # A string's words are in its t element, or in the t of each rich-text run.
        return "".join(t.text or "" for t in [*item.findall(XLSX + "t"), *item.findall(f"{XLSX}r/{XLSX}t")])

    names = book.namelist()
    shared = [words(si) for si in part("xl/sharedStrings.xml").findall(XLSX + "si")] \
        if "xl/sharedStrings.xml" in names else []
    targets = {rel.get("Id"): rel.get("Target") for rel in part("xl/_rels/workbook.xml.rels").iter(XLSX_RELS + "Relationship")}
    tabs = []
    for sheet in part("xl/workbook.xml").iter(XLSX + "sheet"):
        target = targets[sheet.get(XLSX_ID)]
        rows = {}
        for cell in part(target[1:] if target.startswith("/") else f"xl/{target}").iter(XLSX + "c"):
            kind, v = cell.get("t", "n"), cell.find(XLSX + "v")
            raw = v.text or "" if v is not None else ""
            if kind == "s":
                value = shared[int(raw)]
            elif kind == "inlineStr":
                item = cell.find(XLSX + "is")
                value = words(item) if item is not None else ""
            elif kind == "b":
                value = "TRUE" if raw == "1" else "FALSE"
            elif kind in ("str", "e", "d"):
                value = raw
            else:
                value = whole(float(raw)) if raw else ""
            if value == "":
                continue
            ref = re.fullmatch(r"([A-Z]+)(\d+)", cell.get("r", ""))
            column = 0
            for letter in ref.group(1):
                column = column * 26 + ord(letter) - 64
            rows.setdefault(int(ref.group(2)), {})[column] = value
        tabs.append((sheet.get("name"), rows))
    return tabs


def anchor(text):
    """The anchor the website gives a heading with this plain text: Python-Markdown's toc
    rule, which keeps underscores (slugify drops them, as Markdown would)."""
    text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
    return re.sub(r"[-\s]+", "-", re.sub(r"[^\w\s-]", "", text).strip().lower())


def whole(n):
    """812.0 -> 812, so a number reads the same in Python and JavaScript."""
    return int(n) if n.is_integer() and abs(n) < 2 ** 53 else n


def cell_text(value):
    return value.strip() if isinstance(value, str) else str(value)


def column_letters(column):
    out = ""
    while column:
        column, rest = divmod(column - 1, 26)
        out = chr(65 + rest) + out
    return out


def read_date(value):
    """The ISO date in a date cell (a day count from 1899-12-30) or in text such as
    2026-12-02 or 12/2/2026, or None."""
    import datetime
    if isinstance(value, (int, float)):
        if not 1 <= value < 2958466:
            return None
        return (datetime.date(1899, 12, 30) + datetime.timedelta(days=int(value // 1))).isoformat()
    text = value.strip()
    if match := re.fullmatch(r"([0-9]{4})-([0-9]{1,2})-([0-9]{1,2})", text):
        year, month, day = map(int, match.groups())
    elif match := re.fullmatch(r"([0-9]{1,2})/([0-9]{1,2})/([0-9]{4})", text):
        month, day, year = map(int, match.groups())
    else:
        return None
    try:
        return datetime.date(year, month, day).isoformat()
    except ValueError:
        return None


def read_number(value):
    """The number in a number cell, or in text such as 1,200; None if there is none."""
    if isinstance(value, (int, float)):
        return value
    text = value.strip().replace(",", "")
    return whole(float(text)) if NUMBER.fullmatch(text) else None


def load_test_modes(problems):
    """{system: [{"mode", "layer", "anchor"}]}: every hardware system's test modes, from the
    headings of hardware-test-modes.md, such as "### Drivetrain: Stub (Sim)" or
    "### Radio link: Bench" (a mode named after its layer)."""
    modes = {}
    text = MODES_PAGE.read_text(encoding="utf-8")
    for match in re.finditer(r"^### (.+)$", blank_code(text), flags=re.M):
        heading = text[match.start(1):match.end(1)].strip()
        found = re.fullmatch(r"([^:]+): (.+?)(?: \((Sim|Bench|Robot)\))?", heading)
        if not found or not (found.group(3) or found.group(2) in LAYERS):
            problems.error(f"hardware-test-modes.md: the heading {heading!r} is not \"System: Mode (Layer)\", "
                           "such as \"Drivetrain: Stub (Sim)\"; a mode named after its layer needs no (Layer)")
            continue
        system, mode = found.group(1).strip(), found.group(2).strip()
        modes.setdefault(system, []).append({"mode": mode, "layer": found.group(3) or mode, "anchor": anchor(heading)})
    return modes


def mode_name(text):
    """A test mode as the sheet may write it, without its layer: "One computer (Sim)" is
    "One computer"."""
    return re.sub(r"\s*\((?:Sim|Bench|Robot)\)$", "", text.strip())


def judge(tpm, value):
    """How a measured value compares with its TPM: "goal", "threshold" (it meets the
    threshold but not the goal), "missed", or "recorded" when the TPM has no numbers yet."""
    better, goal, threshold = tpm.get("better"), tpm.get("goal_value"), tpm.get("threshold_value")
    if better not in ("lower", "higher") or (goal is None and threshold is None):
        return "recorded"

    def fits(limit):
        return value <= limit if better == "lower" else value >= limit

    if goal is not None and fits(goal):
        return "goal"
    if threshold is not None and fits(threshold):
        return "threshold"
    return "missed"


def read_sheet(tabs, ids):
    """The test sheet's procedures and their problems, from read_workbook's tabs:
    {"procedures": [procedure], "problems": [problem]}. ids is sheet_ids: what a procedure
    may name. A problem is {"text", "reference"}, where reference means it names something
    no registry, or no heading of Hardware test modes, defines."""
    ids = {"nodes": set(ids["nodes"]), "interfaces": set(ids["interfaces"]), "tpms": ids["tpms"],
           "modes": ids["modes"]}
    procedures = []
    for name, rows in tabs:
        title = re.sub(r"\s+", " ", name).strip()
        if title != TEMPLATE_TAB and (proc := read_procedure(title, rows, ids)):
            procedures.append(proc)
    problems, seen = [], {}
    for proc in procedures:
        if proc["slug"] in seen:
            problems.append({"text": f'The tabs "{seen[proc["slug"]]}" and "{proc["title"]}" would have the same '
                                     "link on the website: rename one.", "reference": False})
        seen.setdefault(proc["slug"], proc["title"])
    return {"procedures": procedures, "problems": problems}


def read_procedure(title, rows, ids):
    """One tab as a procedure, or None when it is not one (it has no header row)."""
    def text(row, column):
        return cell_text(rows.get(row, {}).get(column, "")) if row and column else ""

    header = next((r for r in sorted(rows) if text(r, 1).lower() == "row"
                   and "do" in {cell_text(v).lower() for v in rows[r].values()}), None)
    if header is None:
        return None
    columns = {}
    for column, value in sorted(rows[header].items()):
        if key := SHEET_COLUMNS.get(cell_text(value).lower()):
            columns.setdefault(key, column)
    runs = [(c, c + 1 if text(header, c + 1).lower() == "note" else None)
            for c, value in sorted(rows[header].items()) if cell_text(value).lower() == "result"]
    proc = {"title": title, "slug": anchor(title), "purpose": "", "systems": [], "steps": [], "runs": [],
            "problems": []}

    def say(message, reference=False):
        proc["problems"].append({"text": message, "reference": reference})

    def check(r, kind, value):
        if value and value not in ids[f"{kind}s"]:
            tab = {"node": "Nodes", "interface": "Interfaces", "tpm": "TPMs"}[kind]
            name = "TPM" if kind == "tpm" else kind
            say(f'Row {r}: no {name} "{value}" in the design registries. Pick one from the {tab} tab.', True)

    for r in sorted(rows):
        if r < header and text(r, 1).lower() == "purpose" and not proc["purpose"]:
            proc["purpose"] = next((cell_text(v) for c, v in sorted(rows[r].items()) if c > 1 and cell_text(v)), "")
    systems = {system.lower(): system for system in ids["modes"]}
    fixed, numbers = {}, []
    for r in sorted(r for r in rows if r > header):
        kind = text(r, 1)
        fields = {key: text(r, columns.get(key)) for key in STEP_FIELDS}
        used = any(fields.values()) or any(text(r, rc) or text(r, nc) for rc, nc in runs)
        if kind.lower() in ("date", "log"):
            fixed.setdefault(kind.lower(), r)
        elif kind.lower() in systems:
            system = systems[kind.lower()]
            if any(s["system"] == system for s in proc["systems"]):
                say(f"Row {r}: {system} has another row above.")
            else:
                proc["systems"].append({"row": r, "system": system})
        elif not used:
            continue
        elif not kind or kind.lower() == "step" or re.fullmatch(r"[0-9]+", kind):
            # A step: the sheet's script numbers each one in column A.
            proc["steps"].append({"row": r, **fields})
            numbers.append(int(kind) if re.fullmatch(r"[0-9]+", kind) else None)
        else:
            say(f'Row {r}: "{kind}" is not a kind of row: leave column A for the step number, or use Date, Log, '
                "or a system from the Test modes tab.")
    wrong = next(((step, i) for i, (step, n) in enumerate(zip(proc["steps"], numbers), 1) if n is not None and n != i),
                 None)
    if wrong:
        say(f"Row {wrong[0]['row']}: numbered {numbers[wrong[1] - 1]}, but it is step {wrong[1]}. Choose Test "
            "procedures > Set up or repair this sheet to number the steps again.")
    if "date" not in fixed:
        say('The tab has no Date row: add one under the header, with "Date" in column A.')
    if not proc["systems"]:
        say("List the hardware systems the procedure uses: a row for each, under Date, with its name from the "
            "Test modes tab in column A.")
    if not proc["purpose"]:
        say('Write the procedure\'s purpose beside "Purpose", above the table.')

    listed = {s["system"] for s in proc["systems"]}
    for step in proc["steps"]:
        r = step["row"]
        applies, step["applies"] = step["applies"], None
        # Applies when holds "System: Mode" chips: chips for one system mean any of its modes,
        # and chips for different systems mean each of them.
        conditions = []
        for chip in (c.strip() for c in applies.split(",")):
            if not chip:
                continue
            system, colon, mode = chip.partition(":")
            canonical = systems.get(system.strip().lower())
            if not colon or not mode.strip():
                say(f'Row {r}: write each Applies when chip as "System: Mode", such as "Radio link: Bench", '
                    f'not "{chip}".')
            elif canonical is None:
                say(f'Row {r}: no system "{system.strip()}" in Hardware test modes. Pick one from the Test modes tab.',
                    True)
            elif not (known := next((m["mode"] for m in ids["modes"][canonical]
                                     if m["mode"].lower() == mode_name(mode).lower()), None)):
                say(f'Row {r}: {canonical} has no mode "{mode_name(mode)}" in Hardware test modes. Pick one from the '
                    "Test modes tab.", True)
            else:
                condition = next((c for c in conditions if c["system"] == canonical), None)
                if condition is None:
                    conditions.append(condition := {"system": canonical, "modes": []})
                    if canonical not in listed:
                        say(f"Row {r} applies when {canonical} is in a given mode, but the procedure has no "
                            f"{canonical} row: add one under Date.")
                if known not in condition["modes"]:
                    condition["modes"].append(known)
        if conditions:
            step["applies"] = {"text": applies, "conditions": conditions}
        tbd = step["do"].startswith("[TBD") or step["pass_when"].startswith("[TBD")
        if not step["do"] and not tbd:
            say(f"Row {r}: say what to do, under Do.")
        if not step["pass_when"] and not tbd:
            say(f"Row {r}: say what must be seen for the step to pass, under Pass when.")
        check(r, "node", step["node"])
        check(r, "interface", step["interface"])
        check(r, "tpm", step["budget"])
        check(r, "tpm", step["measures"])

    for rc, nc in runs:
        used = [fixed.get("date"), fixed.get("log")] + [s["row"] for s in proc["systems"] + proc["steps"]]
        if not any(text(r, rc) or text(r, nc) for r in used if r):
            continue
        where = f"Run in column {column_letters(rc)}"
        date_value = rows.get(fixed.get("date"), {}).get(rc, "")
        when = read_date(date_value) if date_value != "" else None
        if date_value == "":
            say(f"{where}: give its date, such as 2026-12-02.")
        elif not when:
            say(f'{where}: "{cell_text(date_value)}" is not a date such as 2026-12-02.')
        modes, ready = {}, bool(when)
        for s in proc["systems"]:
            got = text(s["row"], rc)
            mode = next((m for m in ids["modes"][s["system"]] if m["mode"].lower() == mode_name(got).lower()), None)
            if not got:
                say(f"{where}: pick its {s['system']} mode.")
                ready = False
            elif mode is None:
                say(f'{where}: "{got}" is not a {s["system"]} mode in Hardware test modes.')
                ready = False
            else:
                modes[s["system"]] = mode
        if not ready or not modes:
            continue

        results = []
        for step in proc["steps"]:
            r, a = step["row"], step["applies"]
            raw = rows.get(r, {}).get(rc, "")
            got = cell_text(raw) if raw != "" else ""
            missed = [c for c in (a["conditions"] if a else []) if modes.get(c["system"], {}).get("mode") not in c["modes"]]
            applies = not missed
            entry = {"applies": applies, "mark": "", "value": None, "level": "", "note": text(r, nc)}
            number = read_number(raw) if got else None
            if not applies:
                if got:
                    which = ", ".join(f"{c['system']}: {modes[c['system']]['mode']}" if c["system"] in modes
                                      else f"no {c['system']} mode" for c in missed)
                    say(f"{where}, row {r}: the step does not apply to this run ({which}), so leave it blank.")
            elif not got:
                pass
            elif number is not None and step["measures"]:
                tpm = ids["tpms"].get(step["measures"])
                entry["value"] = number
                entry["level"] = judge(tpm, number) if tpm else "recorded"
                entry["mark"] = LEVELS[entry["level"]]
            elif number is not None:
                say(f"{where}, row {r}: {got} is a number, but the step measures no TPM. Mark Pass or Fail, or pick "
                    "the TPM it measures under Measures.")
            elif got.lower() in MARKS:
                entry["mark"] = MARKS[got.lower()]
            else:
                also = ", or type the measured number" if step["measures"] else ""
                say(f'{where}, row {r}: mark Pass or Fail{also}, not "{got}".')
            results.append(entry)
        considered = [(s, e) for s, e in zip(proc["steps"], results) if e["applies"]
                      and not (s["do"].startswith("[TBD") or s["pass_when"].startswith("[TBD"))]
        marks = [e["mark"] for _, e in considered]
        proc["runs"].append({
            "column": column_letters(rc), "date": when,
            "layer": max((m["layer"] for m in modes.values()), key=LAYERS.index),
            "modes": {system: m["mode"] for system, m in modes.items()},
            "steps": results, "log": text(fixed.get("log"), rc),
            "notes": {"date": text(fixed.get("date"), nc), "log": text(fixed.get("log"), nc)},
            "mode_notes": {s["system"]: text(s["row"], nc) for s in proc["systems"]},
            "marked": sum(1 for m in marks if m), "markable": len(marks),
            "result": "Fail" if "Fail" in marks else "Pass" if marks and all(m == "Pass" for m in marks)
            else "Incomplete",
            "threshold_only": list(dict.fromkeys(s["measures"] for s, e in considered if e["level"] == "threshold")),
        })
    return proc


def sheet_ids(reg):
    """What a procedure in the test sheet may name, for read_sheet: the registries' IDs, each
    TPM's numbers to judge a measurement by, and each hardware system's test modes."""
    return {
        "nodes": sorted(reg.nodes), "interfaces": sorted(reg.interfaces),
        "tpms": {t["id"]: {"better": t.get("better"), "threshold_value": t.get("threshold_value"),
                           "goal_value": t.get("goal_value")} for t in reg.tpms},
        "modes": {system: [{"mode": m["mode"], "layer": m["layer"]} for m in modes]
                  for system, modes in reg.test_modes.items()},
    }

def fetch(url, timeout=30):
    import urllib.request
    request = urllib.request.Request(url, headers={"User-Agent": "starrt-luna-software docs build"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return response.read()


def fetch_sheet(reg):
    """(the test sheet read by read_sheet, None) from its published address, or (None,
    why it could not be read)."""
    published = (reg.sheet or {}).get("published", "")
    if not published:
        return None, "the test sheet is not published yet: add its published address to end-to-end-tests.toml"
    try:
        return read_sheet(read_workbook(fetch(f"{published}?output=xlsx")), sheet_ids(reg)), None
    except Exception as error:  # A network, zip, or XML error: say what it was.
        return None, f"{type(error).__name__}: {error}"


def fetch_tab_ids(reg):
    """{tab name: its gid}, for links to each tab, from the published sheet's web page.
    That page is not a documented format, so this returns {} when it cannot read it, and
    links then go to the sheet."""
    import json
    published = (reg.sheet or {}).get("published", "")
    if not published:
        return {}
    try:
        page = fetch(f"{published}html").decode("utf-8")
    except Exception:
        return {}
    found = {}
    for name, gid in re.findall(r'name: "((?:[^"\\]|\\.)*)", pageUrl: "[^"]*?gid=(\d+)', page):
        try:
            found[json.loads('"' + re.sub(r"\\x([0-9a-fA-F]{2})", r"\\u00\1", name) + '"')] = gid
        except ValueError:
            continue
    return found


def check_sheet(problems, reg):
    """Check the test sheet's procedures against the registries and Hardware test modes:
    naming a node, interface, TPM, system, or mode that none defines is an error, so a pull
    request that renames or removes one a procedure uses fails until the sheet is updated."""
    sheet, error = fetch_sheet(reg)
    if sheet is None:
        problems.warn(f"the test sheet was not checked: {error}")
        return 0
    for p in sheet["problems"]:
        problems.warn(f"test sheet: {p['text']}")
    for proc in sheet["procedures"]:
        for p in proc["problems"]:
            report = problems.error if p["reference"] else problems.warn
            report(f'test sheet, tab "{proc["title"]}": {p["text"]}')
    measured = {s["measures"] for proc in sheet["procedures"] for s in proc["steps"]}
    for tpm in reg.tpms:
        if tpm["id"] not in measured and not tpm.get("none"):
            problems.warn(f"{reg.doc_of(tpm)}.toml: {tpm['id']}: no test procedure measures it yet")
    return len(sheet["procedures"])


def registry_csvs(reg):
    """{file name: CSV text}: the lists the test sheet's dropdowns choose from. The website
    publishes them in design/registry/, and the sheet's Nodes, Interfaces, TPMs, and Test
    modes tabs import them."""
    import csv
    import io

    def text(rows):
        out = io.StringIO()
        csv.writer(out, lineterminator="\n").writerows(rows)
        return out.getvalue()

    def bare(value):
        return value.replace("`", "")

    def title(stem):
        # The doc's title, not its file name, which Sheets would show as a link to a .md site.
        path = DESIGN / f"{stem}.md"
        return doc_title(path) if path.exists() else f"{stem} (not written yet)"

    nodes = [["ID", "Name", "Runs on", "Design doc", "What it does"]]
    nodes += [[n["id"], bare(n["name"]), n["runs_on"], title(reg.doc_of(n)), n["does"]]
              for n in by_element(reg.nodes.values())]
    interfaces = [["ID", "Name", "Kind", "Type", "Publisher or server", "Defined in"]]
    interfaces += [[i["id"], bare(i["name"]), i["kind"], i["type"], bare(names(reg.publishers(i))),
                    title(reg.doc_of(i))] for i in sorted(reg.interfaces.values(), key=lambda i: i["id"])]
    tpms = [["ID", "Measure", "Unit", "Threshold", "Goal"]]
    tpms += [[t["id"], t["measure"], t["unit"], t["threshold"], t["goal"]] for t in reg.tpms]
    modes = [["System", "Mode", "Layer", "Choice", "Applies when"]]
    modes += [[system, m["mode"], m["layer"], m["mode"] if m["mode"] == m["layer"] else f"{m['mode']} ({m['layer']})",
               f"{system}: {m['mode']}"] for system, ms in reg.test_modes.items() for m in ms]
    return {"nodes.csv": text(nodes), "interfaces.csv": text(interfaces), "tpms.csv": text(tpms),
            "test-modes.csv": text(modes)}


def sheet_registry(reg):
    """What the website's reader needs from the registries: each ID with how to show it,
    each TPM's numbers, and each hardware system's test modes."""
    return {
        "nodes": {n["id"]: n["name"] for n in reg.nodes.values()},
        "interfaces": {i["id"]: i["name"] for i in reg.interfaces.values()},
        "tpms": {t["id"]: {"anchor": slugify(tpm_title(t)), "measure": t["measure"], "unit": t["unit"],
                           "none": bool(t.get("none")), "better": t.get("better"),
                           "threshold_value": t.get("threshold_value"), "goal_value": t.get("goal_value")}
                 for t in reg.tpms},
        "modes": reg.test_modes,
    }

def inline_html(text):
    """Text as HTML: escaped, with `code` in code font."""
    import html
    return re.sub(r"`([^`]+)`", r"<code>\1</code>", html.escape(text, quote=False))


def procedure_snapshot(reg, proc):
    """A procedure as plain HTML, for site search and for readers without JavaScript. The
    website's script replaces it with the full view, read from the sheet."""
    out = [f"<p>{inline_html(proc['purpose'])}</p>"] if proc["purpose"] else []
    if proc["systems"]:
        out.append(f"<p><strong>Uses:</strong> {inline_html(', '.join(s['system'] for s in proc['systems']))}.</p>")
    if proc["steps"]:
        out.append("<ol>")
        for step in proc["steps"]:
            when = f"<em>For {inline_html(applies_text(step['applies']))}:</em> " if step["applies"] else ""
            check = f" <strong>Pass when:</strong> {inline_html(step['pass_when'])}" if step["pass_when"] else ""
            out.append(f"<li>{when}{inline_html(step['do'])}{check}</li>")
        out.append("</ol>")
    return "\n".join(out)


def applies_text(applies):
    """A step's Applies when in words: "Radio link: Bench or Drive base, and Gamepad: Stub"."""
    return ", and ".join(f"{c['system']}: {' or '.join(c['modes'])}" for c in applies["conditions"])


def sheet_markers(proc):
    """Each [TBD] or [TBR] in a procedure: (row, text of the cell that holds it)."""
    cells = [("Purpose", proc["purpose"])]
    cells += [(s["row"], s[key]) for s in proc["steps"] for key in ("actor", "do", "pass_when")]
    return [(row, value) for row, value in cells if re.search(r"\[(?:TBD|TBR)\b", value)]

