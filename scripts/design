#!/usr/bin/env python3
"""Keeps the design docs' shared tables in registries, and checks that they fit together.

Each design doc has a registry beside it, docs/design/<doc>.toml, that holds its software
elements, nodes, and open questions. Each node defines the topics it publishes and the
services and actions it serves, so every interface lives with its only publisher or
server; a topic many nodes publish by design is a [[shared]] entry instead. A doc shows
them in tables that this script writes between two markers:

    <!-- design: interfaces -->
    (the generated table)
    <!-- /design -->

It also writes pages built from every registry: docs/design/interfaces.md (every node and
interface), docs/design/performance-budgets.md (every technical performance measure, its
budget, and its measurements, from performance-budgets.toml), docs/design/end-to-end-tests.md
(the test procedures that follow one thing the robot does through every node, from
end-to-end-tests.toml), and docs/design/open-items.md (every open question, and every
[TBD] and [TBR] marker in the docs).

    scripts/design render   Rewrite every generated table and page.
    scripts/design check    Check the registries, and that every generated table and page
                            is up to date. Offline; CI runs it on every pull request.
    scripts/design sheet    Print each procedure's first column for the test-run sheet.

Needs only Python 3.11 or newer. See "Registries" in docs/design/README.md.
"""
import argparse
import re
import sys
import tomllib
import unicodedata
from datetime import date
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
DOCS = REPO / "docs"
DESIGN = DOCS / "design"
INTERFACES_PAGE = DESIGN / "interfaces.md"
OPEN_ITEMS_PAGE = DESIGN / "open-items.md"
BUDGETS_PAGE = DESIGN / "performance-budgets.md"
PROCEDURES_PAGE = DESIGN / "end-to-end-tests.md"
LAYERS = ("Sim", "Bench", "Robot")
TEMPLATE = DESIGN / "template.md"
# Pages generated from other data, which the open items scan skips.
GENERATED_PAGES = {INTERFACES_PAGE, OPEN_ITEMS_PAGE, BUDGETS_PAGE, PROCEDURES_PAGE, DOCS / "sources.md"}
# Pages that show markers as examples of how to write them.
EXAMPLE_PAGES = {DOCS / "writing-docs.md"}
# Docs listed first, in this order; the rest follow alphabetically.
DOC_ORDER = ["system", "operating-modes"]

IFACE = [
    ("name", True, "Its name, or a marker while it has none"),
    ("type", True, "Its message, service, or action type"),
    ("rate", True, "How often it is published, or `On demand`"),
    ("qos", True, "Its QoS"),
    ("id", False, "The key other nodes use for it when its name is a marker; otherwise its name"),
    ("note", False, "A sentence shown under the table on the Interfaces page"),
]
# Every kind of registry entry: (where it goes, what it is), then its fields as (field,
# required, what it holds). The README's field reference is generated from this.
SCHEMA = {
    "element": (("`system.toml`", "A software element from the PDR's system hierarchy"), [
        ("id", True, "Its ID in the hierarchy, such as `SW.1.2`"),
        ("name", True, "Its name"),
        ("function", True, "What it does, in one sentence"),
        ("doc", True, "The design doc that designs it, such as `drivetrain.md`"),
        ("parent", False, "The ID of the element above it"),
        ("connects_to", False, "What it connects to outside software"),
        ("turgor", False, "The Turgor deliverables that write its design doc, such as `[\"3.1\"]`"),
    ]),
    "node": (("Each doc's registry", "A node the doc designs"), [
        ("id", True, "The key other entries use for it: its ROS name, once it has one"),
        ("name", True, "What tables show: the ROS name in code font, or plain words while it has none"),
        ("element", True, "The ID of its element"),
        ("runs_on", True, "The computer it runs on"),
        ("does", True, "What it does"),
        ("package", False, "Its ROS package"),
        ("subscribes", False, "IDs of the topics it subscribes to"),
        ("calls", False, "IDs of the services it calls and the actions it sends goals to"),
        ("publishes_shared", False, "IDs of the shared topics it publishes, such as `/diagnostics`"),
    ]),
    "node.publishes": (("Under its `[[node]]`", "A topic the node publishes. No other node publishes it."), IFACE),
    "node.serves": (("Under its `[[node]]`", "A service the node serves. No other node serves it."), IFACE),
    "node.serves_actions": (("Under its `[[node]]`", "An action the node serves. No other node serves it."), IFACE),
    "shared": (("`system.toml`", "A topic many nodes publish by design, such as `/diagnostics`"), IFACE),
    "question": (("Each doc's registry", "A question in the doc's section 9, open or decided"), [
        ("number", True, "Its number in the doc, which never changes"),
        ("text", True, "The question, or once decided, the decision"),
        ("status", True, "`open` or `decided`"),
        ("decided", False, "The date it was decided, such as 2026-10-27; required once decided"),
        ("turgor", False, "The Turgor deliverables that answer it, such as `[\"5.7\"]`"),
    ]),
    "tpm": (("`performance-budgets.toml`", "A technical performance measure and its budget"), [
        ("id", True, "Its ID, such as `TPM-2`"),
        ("measure", True, "The one quantity it measures"),
        ("unit", True, "Its one unit"),
        ("source", True, "The PMP TPM and guidebook rule it tracks, or Derived and what it protects"),
        ("threshold", True, "The least acceptable value"),
        ("goal", True, "The target value"),
        ("budget", False, "The title of its budget table"),
        ("part", False, "The heading of the budget table's first column"),
        ("elements_header", False, "The heading of its elements column"),
        ("allocation", False, "The heading of its allocation column"),
        ("budget_unit", False, "The unit of each row's allocation, shown in each doc's Budgets table"),
        ("cases", False, "Column names when the budget differs by case, such as TELEOP and AUTO"),
        ("limit", False, "The most the counted parts may add up to; the check enforces it"),
        ("notes", False, "Sentences shown under the budget table"),
        ("total_label", False, "The total row's label, when it is not Total"),
        ("total_role", False, "The element that owns the total"),
        ("none", False, "Why it has no budget, shown instead of one"),
        ("better", False, "`lower` or `higher`: which way is better, so a measurement can be judged"),
        ("threshold_value", False, "The threshold as a number in its unit, to judge measurements against"),
        ("goal_value", False, "The goal as a number in its unit, to judge measurements against"),
    ]),
    "tpm.row": (("Under its `[[tpm]]`", "One part of the TPM's budget"), [
        ("part", True, "This part of the budget"),
        ("elements", False, "IDs of the elements it falls to; each doc's Budgets table shows the rows that name its elements"),
        ("role", False, "What each element does for this part, shown instead of the IDs"),
        ("value", False, "The allocation as shown, such as `≤150`; required unless the TPM has cases"),
