def render_interfaces_page(reg):
    out = [
        "# Interfaces",
        "",
        "Every node and every topic, service, and action in the robot software, as the design",
        "docs' registries define them. Each one is defined in exactly one design doc's registry,",
        "beside the node that publishes or serves it, and that doc owns it. To change one, edit",
        "that registry and run `scripts/design render`; see",
        "[Registries](README.md#registries). The [system design](system.md#2-nodes) draws them",
        "as a graph.",
        "",
        "This page is generated from `docs/design/*.toml` by `scripts/design render`.",
        "",
        "## Nodes",
        "",
    ]
    rows = [[n["name"], element_label(reg, n["element"]), n["runs_on"], doc_link(reg.doc_of(n), reg=reg), n["does"]]
            for n in reg.nodes.values()]
    out += table(["Node", "Element", "Runs on", "Design doc", "What it does"], rows)
    out += ["", "## Topics, services, and actions", ""]
    out += table(INTERFACE_HEADER + ["Defined in"], interface_rows(reg, reg.interfaces.values(), defined_in=True))
    notes = [i for i in reg.interfaces.values() if i.get("note")]
    if notes:
        out += ["", "### Notes", ""]
        out += [f"- {code(i['name'])}: {i['note']}" for i in notes]
    return "\n".join(out) + "\n"


def slugify(text):
    """The anchor MkDocs gives a heading (Python-Markdown's toc extension)."""
    text = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)
    text = re.sub(r"[`*_]", "", text)
    text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
    text = re.sub(r"[^\w\s-]", "", text).strip().lower()
    return re.sub(r"[-\s]+", "-", text)


def blank(match):
    return re.sub(r"[^\n]", " ", match.group(0))


def blank_code(text):
    """The text with code blocks and code spans blanked out, keeping positions."""
    text = re.sub(r"^(```|~~~).*?^\1[^\n]*$", blank, text, flags=re.S | re.M)
    return re.sub(r"(`+)[^`\n]*?\1", blank, text)


def mask(text):
    """The text with code, comments, and generated blocks blanked out, keeping positions."""
    text = blank_code(text)
    text = re.sub(r"<!-- design: .*?" + re.escape(END), blank, text, flags=re.S)
    return re.sub(r"<!--.*?-->", blank, text, flags=re.S)


def headings(text, masked):
    """(position, anchor, title) for each heading, with MkDocs's numbering of repeats."""
    found, seen = [], {}
    for match in re.finditer(r"^(#{1,6}) (.+)$", masked, flags=re.M):
        title = text[match.start(2):match.end(2)].strip()
        anchor = slugify(title)
        if anchor in seen:
            seen[anchor] += 1
            anchor = f"{anchor}_{seen[anchor]}"
        else:
            seen[anchor] = 0
        found.append((match.start(), anchor, re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", title)))
    return found


def plain(text):
    text = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)
    return re.sub(r"\s+", " ", text).replace("|", "/").strip()


def markers(path):
    """Each [TBD] or [TBR] in a doc's own text: (heading anchor, heading, kind, text)."""
    text = path.read_text(encoding="utf-8")
    masked = mask(text)
    heads = headings(text, masked)
    found = []
    for match in re.finditer(r"\[(TBD|TBR)(?=[:\]])", masked):
        depth, end = 0, None
        for k in range(match.start(), len(masked)):
            if masked[k] == "[":
                depth += 1
            elif masked[k] == "]":
                depth -= 1
                if depth == 0:
                    end = k
                    break
            elif masked[k] == "\n" and masked[k + 1:k + 2] == "\n":
                break
        if end is None:
            continue
        kind = match.group(1)
        inner = text[match.end():end].lstrip(":").strip()
        if not inner:
            line_start = text.rfind("\n", 0, match.start()) + 1
            line_end = text.find("\n", match.end())
            line = text[line_start:line_end]
            if line.lstrip().startswith("|"):
                cells = line.split("|")
                col = text[line_start:match.start()].count("|")
                cell = cells[col].replace(f"[{kind}]", "").strip() if col < len(cells) else ""
                below = text[line_end + 1:text.find("\n", line_end + 1)]
                is_header = re.fullmatch(r"\s*\|(\s*:?-+:?\s*\|)+\s*", below or "") is not None
                inner = f"every value in the {plain(cell)} column" if is_header else plain(cell)
            else:
                inner = plain(line.replace(f"[{kind}]", ""))
        anchor, title = "", path.stem
        for pos, a, t in heads:
            if pos <= match.start():
                anchor, title = a, t
        found.append((anchor, title, kind, plain(inner)))
    return found


def registry_markers(reg):
    """Each registry value that holds a marker, once: (doc stem, entry, field, text)."""
    found = []
    for kind, store in (("element", reg.elements), ("node", reg.nodes), ("interface", reg.interfaces)):
        for e in store.values():
            for key, value in e.items():
                for v in value if isinstance(value, list) else [value]:
                    if isinstance(v, str) and re.search(r"\[(TBD|TBR)\b", v):
                        found.append((reg.doc_of(e), f"{kind} {e.get('id')}", key, plain(v)))
    for tpm in reg.tpms:
        fields = [(key, v) for key, v in tpm.items() if key not in ("row", "notes")]
        fields += [("note", note) for note in tpm.get("notes", [])]
        fields += [(f"row \"{plain(r['part'])}\": {key}", v) for r in tpm.get("row", []) for key, v in r.items()]
        for key, v in fields:
            if isinstance(v, str) and re.search(r"\[(TBD|TBR)\b", v):
                found.append((reg.doc_of(tpm), tpm["id"], key, plain(v)))
    return found


def render_open_items_page(reg):
    out = [
        "# Open items",
        "",
        "Everything in the docs that is not settled yet, in one place: each design doc's open",
        "questions, then every marked passage. The markers are explained in",
        "[Mark what is not settled](../writing-docs.md#mark-what-is-not-settled). Who works on",
        "an item, and by when, is in Turgor; where a question has a Turgor deliverable, its",
        "number is given.",
        "",
        "To change an item, edit the doc or registry it comes from, then run",
        "`scripts/design render`. This page is generated from the docs and `docs/design/*.toml`",
        "by `scripts/design render`.",
        "",
        "## Open questions",
    ]
    total = 0
    for stem in sorted(reg.questions, key=lambda s: doc_sort_key(Path(s))):
        # Links are dropped here, so a source cited in a question is cited only by its doc.
        rows = [[f"{q['number']}. {plain(q['text'])}", ", ".join(q.get("turgor", [])) or "None"]
                for q in reg.questions[stem] if q["status"] == "open"]
        if not rows:
            continue
        total += len(rows)
        md = DESIGN / f"{stem}.md"
        if md.exists():
            text = md.read_text(encoding="utf-8")
            at = text.find("<!-- design: questions")
            anchor = ""
            for pos, a, _ in headings(text, mask(text)):
                if 0 <= at and pos < at:
                    anchor = a
            out += ["", f"### [{doc_title(md)}]({md.name}{'#' + anchor if anchor else ''})", ""]
        else:
            out += ["", f"### {doc_link(stem, reg=reg)}", ""]
        out += table(["Question", "Turgor"], rows)
    if not total:
        out += ["", "None."]

    out += ["", "## Marked in the registries", "",
            "Values in the design registries that are not settled yet. They show in every table",
            "that uses them; each is listed here once."]
    by_doc = {}
    for stem, entry, field, text in registry_markers(reg):
        by_doc.setdefault(stem, []).append([entry, field, text])
    for stem in sorted(by_doc, key=lambda s: doc_sort_key(Path(s))):
        out += ["", f"### `{stem}.toml`", ""]
        out += table(["Entry", "Field", "Value"], by_doc[stem])

    out += ["", "## Marked in the test sheet", "",
            "Every `[TBD]` and `[TBR]` in the end-to-end test procedures, which live in the",
            f"[test sheet]({PROCEDURES_PAGE.name}). This page reads the sheet each time it opens.", "",
            TEST_SHEET.format("open-items")]

    out += ["", "## Marked in the docs", "",
            "Every `[TBD]` and `[TBR]` in the docs' own text, by page and section."]
    pages = sorted(p for p in DOCS.rglob("*.md") if p not in GENERATED_PAGES and p not in EXAMPLE_PAGES)
    pages.sort(key=lambda p: (p.parent != DESIGN, doc_sort_key(p) if p.parent == DESIGN else (0, str(p))))
    for page in pages:
        found = markers(page)
        if not found:
            continue
        link = (Path("..", page.relative_to(DOCS)) if page.parent != DESIGN else Path(page.name)).as_posix()
        out += ["", f"### [{doc_title(page)}]({link})", ""]
        rows = [[f"[{title}]({link}#{anchor})" if anchor else title, f"[{kind}: {text}]"]
                for anchor, title, kind, text in found]
        out += table(["Section", "Marked"], rows)
    return "\n".join(out + ["", TEST_SHEET.format("data")]) + "\n"


# ----------------------------------------------------------------------------------------
# Commands
# ----------------------------------------------------------------------------------------

# The open items page reads the other pages' sources, so it is written last.
PAGES = ((INTERFACES_PAGE, render_interfaces_page), (BUDGETS_PAGE, render_budgets_page),
         (PROCEDURES_PAGE, render_procedures_page), (OPEN_ITEMS_PAGE, render_open_items_page))

def outputs(problems, reg):
    """{path: text} for every file render would write."""
    result = {}
    for path in sorted(DESIGN.glob("*.md")):
        # The template's markers are copied into each new doc, which then has a registry.
        if path in GENERATED_PAGES or path == TEMPLATE:
            continue
        text = path.read_text(encoding="utf-8")
        if "<!-- design:" in text:
            result[path] = render_doc(problems, reg, path, text)
    # The pages read the docs, so they come after the docs' blocks are written.
    return result


def cmd_render(_args):
    problems = Problems()
    reg = load(problems)
    if not problems.errors:
        validate(problems, reg)
    if problems.errors:
        return problems.report()
    written = []
    for path, text in outputs(problems, reg).items():
        if path.read_text(encoding="utf-8") != text:
            path.write_text(text, encoding="utf-8")
            written.append(path)
    for path, render in PAGES:
        text = render(reg)
        if not path.exists() or path.read_text(encoding="utf-8") != text:
            path.write_text(text, encoding="utf-8")
            written.append(path)
    for path in written:
        print(f"Wrote {path.relative_to(REPO)}")
    print(f"{len(reg.elements)} elements, {len(reg.nodes)} nodes, {len(reg.interfaces)} interfaces, "
          f"{sum(len(q) for q in reg.questions.values())} questions; {len(written)} files changed.")
    return problems.report()


def cmd_check(_args):
    problems = Problems()
    reg = load(problems)
    if not problems.errors:
        validate(problems, reg)
    procedures = None
    if not problems.errors:
        for path, text in outputs(problems, reg).items():
            if path.read_text(encoding="utf-8") != text:
                problems.error(f"{path.relative_to(REPO)} has a generated table that is out of date: "
                               "run scripts/design render")
        for path, render in PAGES:
            if not path.exists() or path.read_text(encoding="utf-8") != render(reg):
                problems.error(f"{path.relative_to(REPO)} is out of date: run scripts/design render")
        procedures = check_sheet(problems, reg)
    if not problems.errors:
        print(f"OK: {len(reg.elements)} elements, {len(reg.nodes)} nodes, {len(reg.interfaces)} interfaces, "
              f"{sum(len(q) for q in reg.questions.values())} questions, {len(reg.tpms)} TPMs, "
              f"{procedures} test procedures in the test sheet; every generated table is up to date.")
    return problems.report()


def cmd_sheet_json(args):
    """The test sheet as read_sheet reads it, with the IDs it was checked against, as JSON:
    what scripts/test-sheet-readers.js compares the website's reader with."""
    import json
    problems = Problems()
    reg = load(problems)
    if not problems.errors:
        validate(problems, reg)
    if problems.errors:
        return problems.report()
    ids = sheet_ids(reg)
    data = Path(args.xlsx).read_bytes() if args.xlsx else fetch(f"{reg.sheet['published']}?output=xlsx")
    print(json.dumps({"ids": ids, "sheet": read_sheet(read_workbook(data), ids)}, indent=1, ensure_ascii=False))
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0],
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("render", help="Rewrite every generated table and page.").set_defaults(run=cmd_render)
    commands.add_parser("check", help="Check the registries and that everything generated is current.").set_defaults(run=cmd_check)
    sheet_json = commands.add_parser("sheet-json", help="Print the test sheet as the build reads it, as JSON.")
    sheet_json.add_argument("xlsx", nargs="?", help="An .xlsx file to read instead of the published sheet")
    sheet_json.set_defaults(run=cmd_sheet_json)
    args = parser.parse_args()
    return args.run(args)


if __name__ == "__main__":
    sys.exit(main())
