}
# Tables written under an entry: (parent kind, key) -> schema name.
SUBTABLES = {"row": "tpm.row", "step": "procedure.step", "pass": "procedure.pass"}


def fields(table):
    """(required, optional) field names of one kind of entry."""
    entries = SCHEMA[table][1]
    return [f for f, req, _ in entries if req], [f for f, req, _ in entries if not req]


# The interfaces a node defines, under it, and the kind each one is.
NESTED = {"publishes": "topic", "serves": "service", "serves_actions": "action"}
FIELDS = {t: fields(t) for t in ("element", "node", "shared", "question", "tpm", "procedure", "sheet")}
FIELDS["node"][1].extend(NESTED)
FIELDS["tpm"][1].append("row")
FIELDS["procedure"][1].extend(["step", "pass"])
LISTS = {"subscribes", "calls", "publishes_shared", "turgor", "elements", "cases", "notes", "measures"}
NUMBERS = {"limit", "amount", "threshold_value", "goal_value", "sheet_gid"}
TURGOR = re.compile(r"\d+\.\d+")

START = re.compile(r"<!-- design: ([a-z]+)((?: [a-z]+)*)(?: \([^)]*\))? -->")
END = "<!-- /design -->"
# Each block a doc can hold: (its options, what it shows). The README's list is generated
# from this.
BLOCK_HELP = {
    "nodes": (["connected"], "The nodes in this doc's registry. With `connected`, also every node that publishes or subscribes to this doc's interfaces, with its design doc."),
    "interfaces": ([], "The topics, services, and actions this doc's nodes define, then the ones they use from other docs"),
    "questions": ([], "This doc's open and decided questions"),
    "budgets": ([], "Every budget row in `performance-budgets.toml` that names one of this doc's elements"),
    "elements": ([], "Every software element"),
    "graph": ([], "A diagram of every node, with an arrow for each topic and call"),
    "fields": ([], "This reference of registry fields"),
    "blocks": ([], "This list of blocks"),
}
BLOCKS = {kind: options for kind, (options, _) in BLOCK_HELP.items()}
# Blocks that show the doc's own registry, so the doc needs one beside it.
OWN_REGISTRY = {"nodes", "interfaces", "questions", "budgets"}
NOTE = "generated from {registry} by scripts/design render: edit that file, not this table"


class Problems:
    """Collects errors and warnings so a check can report all of them at once."""

    def __init__(self):
        self.errors = []
        self.warnings = []

    def error(self, message):
        self.errors.append(message)

    def warn(self, message):
        self.warnings.append(message)

    def report(self):
        for message in self.warnings:
            print(f"warning: {message}", file=sys.stderr)
        for message in self.errors:
            print(f"error: {message}", file=sys.stderr)
        return 1 if self.errors else 0


# ----------------------------------------------------------------------------------------
# Registries
# ----------------------------------------------------------------------------------------

class Registry:
    """Every registry's entries, keyed for lookup, and where each one is defined."""

    def __init__(self):
        self.elements = {}    # id -> entry
        self.nodes = {}       # id -> entry
        self.interfaces = {}  # id -> entry
        self.owner = {}       # id(interface) -> id of the node that publishes or serves it
        self.questions = {}   # doc stem -> [entries]
        self.tpms = []        # entries, in order
        self.procedures = []  # entries, in order
        self.sheet = None     # the test-run sheet, if one is set
        self.home = {}        # id(entry) -> doc stem of the registry that defines it

    def doc_of(self, entry):
        return self.home[id(entry)]

    def publishers(self, iface):
        if iface.get("shared"):
            return [n for n in self.nodes.values() if iface["id"] in n.get("publishes_shared", [])]
        return [self.nodes[self.owner[id(iface)]]]

    def subscribers(self, iface):
        verb = "subscribes" if iface["kind"] == "topic" else "calls"
        return [n for n in self.nodes.values() if iface["id"] in n.get(verb, [])]


def registry_files():
    return sorted(DESIGN.glob("*.toml"), key=doc_sort_key)


def doc_sort_key(path):
    stem = path.stem
    return (DOC_ORDER.index(stem) if stem in DOC_ORDER else len(DOC_ORDER), stem)


def check_value(problems, where, key, value):
    if key in LISTS:
        if not isinstance(value, list) or not all(isinstance(v, str) for v in value):
            problems.error(f"{where}: {key} must be a list of strings")
            return
        values = value
    elif key in NUMBERS:
        if not isinstance(value, (int, float)) or isinstance(value, bool):
            problems.error(f"{where}: {key} must be a number")
        return
    elif key == "amounts":
        if not isinstance(value, list) or not all(isinstance(v, (int, float)) for v in value):
            problems.error(f"{where}: amounts must be a list of numbers")
        return
    elif key in SUBTABLES:
        name = SUBTABLES[key]
        if not isinstance(value, list) or not all(isinstance(v, dict) for v in value):
            problems.error(f"{where}: {key} must be [[{name}]] entries")
            return
        for n, row in enumerate(value, 1):
            check_entry(problems, f"{where}, {key} {n}", row, *fields(name))
        return
    elif key in NESTED:
        if not isinstance(value, list) or not all(isinstance(v, dict) for v in value):
            problems.error(f"{where}: {key} must be [[node.{key}]] entries, one per interface")
        return
    elif key == "number":
        if not isinstance(value, int):
            problems.error(f"{where}: number must be a whole number")
        return
    elif key in ("decided", "date"):
        if not isinstance(value, date):
            problems.error(f"{where}: {key} must be a date, such as 2026-10-27")
        return
    else:
        if not isinstance(value, str) or not value.strip():
            problems.error(f"{where}: {key} must be text")
            return
        values = [value]
    for v in values:
        if "|" in v or "\n" in v:
            problems.error(f"{where}: {key} may not contain | or a line break, which would break the table")
        if v.count("[") != v.count("]"):
            problems.error(f"{where}: {key} has unbalanced brackets: {v!r}")


def check_entry(problems, where, entry, required, optional):
    for key in required:
        if key not in entry:
            problems.error(f"{where} has no {key}")
    for key, value in entry.items():
        if key not in required and key not in optional:
            problems.error(f"{where} has an unknown field {key!r}")
        else:
            check_value(problems, where, key, value)


def add_interface(problems, reg, where, stem, entry):
    entry.setdefault("id", entry.get("name", ""))
    reg.home[id(entry)] = stem
    key = entry["id"]
    if key in reg.interfaces:
        problems.error(f"{where}: {key!r} is also defined in {reg.doc_of(reg.interfaces[key])}.toml. "
                       "Only one node publishes or serves an interface; others subscribe to it or call it.")
    reg.interfaces[key] = entry


def load(problems):
    reg = Registry()
    for path in registry_files():
        stem = path.stem
        try:
            with path.open("rb") as f:
                data = tomllib.load(f)
        except tomllib.TOMLDecodeError as e:
            problems.error(f"{path.name}: {e}")
            continue
        for table in data:
            if table not in FIELDS:
                problems.error(f"{path.name}: unknown table [[{table}]]; use {', '.join(FIELDS)}")
        for kind, (required, optional) in FIELDS.items():
            for n, entry in enumerate(data.get(kind, []), 1):
                label = entry.get("id") or entry.get("name") or entry.get("number") or n
                where = f"{path.name}: {kind} {label}"
                check_entry(problems, where, entry, required, optional)
                reg.home[id(entry)] = stem
                if kind == "shared":
                    entry["kind"], entry["shared"] = "topic", True
                    add_interface(problems, reg, where, stem, entry)
                    continue
                if kind == "node":
                    for verb, iface_kind in NESTED.items():
                        subs = entry.get(verb, [])
                        for sub in subs if isinstance(subs, list) else []:
                            if not isinstance(sub, dict):
                                continue
                            sub_where = f"{where} {verb} {sub.get('id') or sub.get('name')}"
                            if "kind" in sub:
                                sub.pop("kind")
                                problems.error(f"{sub_where} has a kind, but the table says it: "
                                               "[[node.publishes]] holds topics, [[node.serves]] services, "
                                               "and [[node.serves_actions]] actions")
                            check_entry(problems, sub_where, sub, *fields(f"node.{verb}"))
                            sub["kind"] = iface_kind
                            reg.owner[id(sub)] = entry.get("id")
                            add_interface(problems, reg, sub_where, stem, sub)
                if kind == "question":
                    reg.questions.setdefault(stem, []).append(entry)
                    continue
                if kind == "tpm":
                    reg.tpms.append(entry)
                    continue
                if kind == "procedure":
                    reg.procedures.append(entry)
                    continue
                if kind == "sheet":
                    if reg.sheet is not None:
                        problems.error(f"{where}: there is one test-run sheet; this is a second [[sheet]]")
                    reg.sheet = entry
                    continue
                store = {"element": reg.elements, "node": reg.nodes}[kind]
                key = entry.get("id", "")
                if key in store:
                    problems.error(f"{where}: {kind} {key!r} is also defined in {reg.doc_of(store[key])}.toml")
                store[key] = entry
    return reg


def validate(problems, reg):
    for e in reg.elements.values():
        where = f"{reg.doc_of(e)}.toml: element {e['id']}"
        if e.get("parent") and e["parent"] not in reg.elements:
            problems.error(f"{where}: no element {e['parent']!r} for its parent")
        doc = e.get("doc", "")
        if not re.fullmatch(r"[a-z0-9-]+\.md", doc):
            problems.error(f"{where}: doc must be a design doc's file name, such as drivetrain.md")
        elif not (DESIGN / doc).exists() and not (DESIGN / doc).with_suffix(".toml").exists():
            problems.error(f"{where}: no {doc} or {Path(doc).stem}.toml in docs/design")
        for t in e.get("turgor", []):
            if not TURGOR.fullmatch(t):
                problems.error(f"{where}: turgor holds deliverable numbers, such as 3.1, not {t!r}")
    for n in reg.nodes.values():
        where = f"{reg.doc_of(n)}.toml: node {n['id']}"
        if n.get("element") not in reg.elements:
            problems.error(f"{where}: no element {n.get('element')!r}")
        for verb, kinds, defined_under in (("subscribes", ("topic",), "[[node.publishes]]"),
                                           ("calls", ("service", "action"),
                                            "[[node.serves]] or [[node.serves_actions]]")):
            for ref in n.get(verb, []):
                iface = reg.interfaces.get(ref)
                if iface is None:
                    problems.error(f"{where} {verb} {ref!r}, which no registry defines. The node that "
                                   f"{'publishes' if verb == 'subscribes' else 'serves'} it defines it, "
                                   f"under {defined_under} in its own registry.")
                elif iface.get("kind") not in kinds:
                    problems.error(f"{where} {verb} {ref!r}, which is a {iface.get('kind')}: "
                                   f"a node {verb} only a {' or '.join(kinds)}")
        for ref in n.get("publishes_shared", []):
            iface = reg.interfaces.get(ref)
            if iface is None or not iface.get("shared"):
                whose = f", which {reg.owner[id(iface)]} publishes" if iface else ""
                problems.error(f"{where} lists {ref!r} under publishes_shared{whose}. publishes_shared "
                               "is for a topic many nodes publish by design, defined as a [[shared]] entry; "
                               "a topic with one publisher is defined under that node's [[node.publishes]].")
    for i in reg.interfaces.values():
        where = f"{reg.doc_of(i)}.toml: {'shared topic' if i.get('shared') else 'interface'} {i['id']}"
        if i.get("shared") and not reg.publishers(i):
            problems.error(f"{where}: no node publishes it; list it under a node's publishes_shared")
        if not reg.subscribers(i):
            problems.warn(f"{where}: nothing uses it yet")
    seen = set()
    for tpm in reg.tpms:
        where = f"{reg.doc_of(tpm)}.toml: {tpm.get('id')}"
        if tpm.get("id") in seen:
            problems.error(f"{where} appears twice")
        seen.add(tpm.get("id"))
        cases = tpm.get("cases", [])
        for n, row in enumerate(tpm.get("row", []), 1):
            for e in row.get("elements", []):
                if e not in reg.elements:
                    problems.error(f"{where}, row {n}: no element {e!r}")
            if cases:
                if len(row.get("amounts", [])) != len(cases):
                    problems.error(f"{where}, row {n}: give amounts, one for each of the {len(cases)} cases")
            elif "value" not in row:
                problems.error(f"{where}, row {n} has no value")
        for case, total, limit, _ in budget_totals(tpm):
            if limit is not None and total > limit:
                label = f" in {case}" if case else ""
                problems.error(f"{where}: its parts{label} add up to {number(total)}, over its limit of {number(limit)}")
    tpm_ids = {tpm.get("id") for tpm in reg.tpms}
    seen = set()
    for proc in reg.procedures:
        where = f"{reg.doc_of(proc)}.toml: procedure {proc.get('id')}"
        if proc.get("id") in seen:
            problems.error(f"{where} appears twice")
        seen.add(proc.get("id"))
        measures = proc.get("measures", [])
        for tid in measures:
            if tid not in tpm_ids:
                problems.error(f"{where} measures {tid!r}, which no [[tpm]] defines")
        for n, step in enumerate(proc.get("step", []), 1):
            if "node" not in step and "actor" not in step:
                problems.error(f"{where}, step {n}: name the node that acts, or the actor")
            if "node" in step and step["node"] not in reg.nodes:
                problems.error(f"{where}, step {n}: no node {step['node']!r}")
            if "interface" in step and step["interface"] not in reg.interfaces:
                problems.error(f"{where}, step {n}: no interface {step['interface']!r}")
            if "budget" in step and step["budget"] not in tpm_ids:
                problems.error(f"{where}, step {n}: no TPM {step['budget']!r}")
        for n, line in enumerate(proc.get("pass", []), 1):
            if "tpm" in line and line["tpm"] not in measures:
                problems.error(f"{where}, pass {n} checks {line['tpm']}, which the procedure does not list "
                               "under measures")
        if "sheet_gid" in proc and not isinstance(proc["sheet_gid"], int):
            problems.error(f"{where}: sheet_gid is the whole number after gid= in the tab's address")
    gids = [proc["sheet_gid"] for proc in reg.procedures if "sheet_gid" in proc]
    for gid in {g for g in gids if gids.count(g) > 1}:
        problems.error(f"end-to-end-tests.toml: two procedures use the sheet tab gid {gid}")
    if reg.sheet:
        for key, start in (("edit_url", "https://docs.google.com/spreadsheets/d/"),
                           ("published", "https://docs.google.com/spreadsheets/d/e/")):
            if key in reg.sheet and not str(reg.sheet[key]).startswith(start):
                problems.error(f"end-to-end-tests.toml: the sheet's {key} must start with {start}")
    measured = {tid for proc in reg.procedures for tid in proc.get("measures", [])}
    for tpm in reg.tpms:
        if tpm.get("id") not in measured and not tpm.get("none"):
            problems.warn(f"{reg.doc_of(tpm)}.toml: {tpm.get('id')}: no test procedure measures it yet")
        if ("threshold_value" in tpm or "goal_value" in tpm) and tpm.get("better") not in ("lower", "higher"):
            problems.error(f"{reg.doc_of(tpm)}.toml: {tpm.get('id')}: better must be lower or higher, "
                           "so a measurement can be judged against its values")
    for stem, questions in reg.questions.items():
        seen = set()
        for q in questions:
            where = f"{stem}.toml: question {q.get('number')}"
            if q.get("number") in seen:
                problems.error(f"{where} appears twice")
            seen.add(q.get("number"))
            status = q.get("status")
            if status not in ("open", "decided"):
                problems.error(f"{where}: status must be open or decided")
            elif status == "decided" and "decided" not in q:
                problems.error(f"{where}: a decided question needs the date it was decided")
            elif status == "open" and "decided" in q:
                problems.error(f"{where}: an open question has no decided date")
            for t in q.get("turgor", []):
                if not TURGOR.fullmatch(t):
                    problems.error(f"{where}: turgor holds deliverable numbers, such as 5.7, not {t!r}")


# ----------------------------------------------------------------------------------------
# Rendering helpers
# ----------------------------------------------------------------------------------------

def table(header, rows):
    out = ["| " + " | ".join(header) + " |", "| " + " | ".join("---" for _ in header) + " |"]
    for row in rows:
        out.append("| " + " | ".join(cell or " " for cell in row) + " |")
    return out


def code(name):
    """Interface names in code font, unless they are not decided yet."""
    return name if "[" in name else f"`{name}`"


def doc_link(stem, reg=None):
    """A link to a design doc from another page in docs/design, or its file name when it
    is not written yet."""
    path = DESIGN / f"{stem}.md"
    if path.exists():
        return f"[{doc_title(path)}]({path.name})"
    deliverables = sorted({t for e in (reg.elements.values() if reg else []) if e["doc"] == f"{stem}.md"
                           for t in e.get("turgor", [])})
    when = f", not written yet ({', '.join(deliverables)})" if deliverables else ", not written yet"
    return f"`{stem}.md`{when}"


def doc_title(path):
    for line in path.read_text(encoding="utf-8").splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return path.stem


def element_key(element_id):
    """SW.1.10 after SW.1.9: the parts of an element's id, compared as numbers."""
    return [int(p) if p.isdigit() else -1 for p in element_id.split(".")]


def by_element(nodes):
    return sorted(nodes, key=lambda n: (element_key(n["element"]), n["name"]))


def element_label(reg, element_id):
    e = reg.elements.get(element_id)
    return f"{element_id} {e['name']}" if e else element_id


def nodes_of(reg, stem):
    return [n for n in reg.nodes.values() if reg.doc_of(n) == stem]


def interfaces_of(reg, stem):
    """Interfaces this doc defines, then the ones its nodes use from other docs."""
    own_nodes = nodes_of(reg, stem)
    used = set()
    for n in own_nodes:
        for verb in ("subscribes", "calls", "publishes_shared"):
            used.update(n.get(verb, []))
    defined = [i for i in reg.interfaces.values() if reg.doc_of(i) == stem]
    others = [i for i in reg.interfaces.values() if i["id"] in used and reg.doc_of(i) != stem]
    return defined + others


def names(nodes):
    return ", ".join(n["name"] for n in by_element(nodes))


def interface_rows(reg, interfaces, defined_in=False):
    rows = []
    for i in interfaces:
        row = [code(i["name"]), i["kind"], code(i["type"]), i["rate"],
               names(reg.publishers(i)), names(reg.subscribers(i)) or "None yet", i["qos"]]
        if defined_in:
            row.append(doc_link(reg.doc_of(i), reg=reg))
        rows.append(row)
    return rows


INTERFACE_HEADER = ["Name", "Kind", "Type", "Rate", "Publisher or server", "Subscriber or client", "QoS"]


# ----------------------------------------------------------------------------------------
# Blocks inside docs
# ----------------------------------------------------------------------------------------

def block_nodes(reg, stem, options):
    nodes = nodes_of(reg, stem)
    if "connected" in options:
        ids = {n["id"] for n in nodes}
        others = {}
        for i in interfaces_of(reg, stem):
            for n in reg.publishers(i) + reg.subscribers(i):
                if n["id"] not in ids:
                    others[n["id"]] = n
        nodes += by_element(others.values())
        rows = [[n["name"], n.get("package", "[TBD]"), n["runs_on"], element_label(reg, n["element"]),
                 doc_link(reg.doc_of(n), reg=reg), n["does"]] for n in nodes]
        return table(["Node", "Package", "Runs on", "Element", "Design doc", "What it does"], rows)
    rows = [[n["name"], n.get("package", "[TBD]"), n["runs_on"], element_label(reg, n["element"]), n["does"]]
            for n in nodes]
    return table(["Node", "Package", "Runs on", "Element", "What it does"], rows)


def block_interfaces(reg, stem, options):
    return table(INTERFACE_HEADER, interface_rows(reg, interfaces_of(reg, stem)))


def block_questions(reg, stem, options):
    rows = []
    for q in reg.questions.get(stem, []):
        status = "Open" if q["status"] == "open" else f"Decided {q['decided'].isoformat()}"
        rows.append([f"{q['number']}. {q['text']}", status, ", ".join(q.get("turgor", [])) or "None"])
    return table(["Question", "Status", "Turgor"], rows)


def block_elements(reg, stem, options):
    rows = []
    for e in sorted(reg.elements.values(), key=lambda e: element_key(e["id"])):
        rows.append([e["id"], e["name"], e["function"], e.get("connects_to", "None"),
                     doc_link(Path(e["doc"]).stem, reg=reg), ", ".join(e.get("turgor", [])) or "None"])
    return table(["ID", "Element", "Function", "Connects to (other teams' parts)", "Design doc", "Turgor"], rows)


def mermaid_text(text):
    """Mermaid cannot show markers or code font, so it gets plain words and a short tag."""
    tag = ""
    if "[TBD" in text:
        tag = " (TBD)"
    elif "[TBR" in text:
        tag = " (TBR)"
    bare = re.fullmatch(r"\[(?:TBD|TBR): ([^,\]]+)[^\]]*\]", text.strip())
    if bare:
        # A name that is only a marker, such as "[TBD: obstacle map topic, ...]".
        text = bare.group(1)
    text = re.sub(r"\s*\[(?:TBD|TBR)(?::[^\]]*)?\]", "", text)
    text = text.replace("`", "").replace('"', "#quot;").strip()
    return (text or "not named yet") + tag


def block_graph(reg, stem, options):
    """Every node, grouped by the computer it runs on, with an arrow per topic or call.
    Shared topics, such as /diagnostics, would add an arrow from nearly every node, so the
    text around the graph names them instead."""
    out = ["```mermaid", "flowchart LR"]
    ids = {}
    groups = {}
    for n in by_element(reg.nodes.values()):
        ids[n["id"]] = "n" + re.sub(r"[^A-Za-z0-9]", "_", n["id"])
        groups.setdefault(mermaid_text(n["runs_on"]), []).append(n)
    for g, (where, nodes) in enumerate(groups.items()):
        out.append(f'  subgraph g{g}["{where}"]')
        for n in nodes:
            out.append(f'    {ids[n["id"]]}["{mermaid_text(n["name"])}"]')
        out.append("  end")
    for i in reg.interfaces.values():
        if i.get("shared"):
            continue
        label = mermaid_text(i["name"])
        arrow = "-->" if i["kind"] == "topic" else "-.->"
        for p in reg.publishers(i):
            for s in reg.subscribers(i):
                if i["kind"] == "topic":
                    out.append(f'  {ids[p["id"]]} {arrow}|"{label}"| {ids[s["id"]]}')
                else:
                    out.append(f'  {ids[s["id"]]} {arrow}|"{label}"| {ids[p["id"]]}')
    out.append("```")
    return out


# ----------------------------------------------------------------------------------------
# Performance budgets
# ----------------------------------------------------------------------------------------

def number(n):
    """150 -> "150", 1000 -> "1,000", 11.5 -> "11.5"."""
    if isinstance(n, float) and n.is_integer():
        n = int(n)
    return f"{n:,}" if isinstance(n, int) else f"{n:,.2f}".rstrip("0").rstrip(".")


def unknown(row):
    """A part of the budget that is not decided yet, so the total cannot count it."""
    return "amount" not in row and "amounts" not in row and "[TBD" in row.get("value", "")


def counted(row):
    return "amount" in row or "amounts" in row


def budget_totals(tpm):
    """(case, total, limit, any part unknown) for each case, or one with case None."""
    rows = tpm.get("row", [])
    if not any(counted(r) for r in rows):
        return []
    limit = tpm.get("limit")
    if tpm.get("cases"):
        return [(case, sum(r["amounts"][i] for r in rows if len(r.get("amounts", [])) > i), limit, False)
                for i, case in enumerate(tpm["cases"])]
    return [(None, sum(r["amount"] for r in rows if "amount" in r), limit, any(unknown(r) for r in rows))]


def tpm_title(tpm):
    return f"{tpm['id']}: {tpm['measure'].split(' (')[0]}"


def tpm_link(tpm, page=""):
    return f"{page}#{slugify(tpm_title(tpm))}"


def budget_table(tpm):
    rows = tpm.get("row", [])
    cases = tpm.get("cases", [])
    has_unit = any("unit" in r for r in rows)
    has_basis = any("basis" in r for r in rows)
    header = [tpm.get("part", "Part"), tpm.get("elements_header", "Elements")]
    header += cases or [tpm.get("allocation", "Allocation")]
    header += ["Unit"] * has_unit + ["Basis"] * has_basis

    def cells(r):
        out = [r["part"], r.get("role") or ", ".join(r.get("elements", [])) or "None"]
        out += [number(a) for a in r.get("amounts", [])] if cases else [r.get("value", "")]
        return out + [r.get("unit", "")] * has_unit + [r.get("basis", "")] * has_basis

    totals = budget_totals(tpm)
    if not totals:
        return table(header, [cells(r) for r in rows])
    # Parts that add up come first, then the total, then rows the total does not count.
    before = [r for r in rows if counted(r) or unknown(r)]
    after = [r for r in rows if not (counted(r) or unknown(r))]
    total_cells = []
    for case, total, limit, missing in totals:
        text = f"**{number(total)}**"
        if limit is not None:
            text += f" of {number(limit)}, leaving {number(limit - total)}"
        if missing:
            text += ", not counting the parts still TBD"
        total_cells.append(text)
    units = {r.get("unit") for r in rows if counted(r)}
    total_row = [f"**{tpm.get('total_label', 'Total')}**", tpm.get("total_role", "")] + total_cells
    total_row += [units.pop() if len(units) == 1 and None not in units else ""] * has_unit + [""] * has_basis
    return table(header, [cells(r) for r in before] + [total_row] + [cells(r) for r in after])


def carries(reg):
    """{element id: set of TPM ids}: the TPMs each element's budgets name, and a parent
    carries what its children carry."""
    found = {e: set() for e in reg.elements}
    for tpm in reg.tpms:
        for r in tpm.get("row", []):
            for e in r.get("elements", []):
                found.setdefault(e, set()).add(tpm["id"])
    for e in sorted(reg.elements, key=element_key, reverse=True):
        parent = reg.elements[e].get("parent")
        if parent in found:
            found[parent] |= found[e]
    return found


def tpm_number(tpm_id):
    return int(tpm_id.split("-")[1]) if tpm_id.split("-")[-1].isdigit() else 0


def render_budgets_page(reg):
    out = [
        "# Performance budgets",
        "",
        "The technical performance measures (TPMs) the robot software is held to, and how each",
        "one is split across the software elements in the",
        "[system design](system.md#software-elements). Each TPM is one measurable quantity with",
        "one unit:",
        "",
        "- **Source** is the higher-level requirement it tracks: a TPM in the PMP's Table 3, and",
        "  the guidebook rule behind it. \"Derived\" means the PMP has no matching TPM, and the",
        "  measure protects the ones it names.",
        "- **Threshold** is the least acceptable value, and **goal** is the target, as in PMP",
        "  Table 3.",
        "- **Not allocated to software:** berm volume (software affects it only through TPM-1),",
        "  dimensions, and dust tolerance. They belong to the hardware.",
        "",
        "Each design doc shows its own elements' budgets in its Budgets table. To change a",
        "budget, edit `performance-budgets.toml` and run `scripts/design render`. The check",
        "fails when a budget's parts add up to more than its limit, and every margin and total",
        "here is computed, not typed.",
        "",
        "This page is generated from `docs/design/performance-budgets.toml` by",
        "`scripts/design render`.",
        "",
        "## Measures",
        "",
    ]
    rows = []
    for tpm in reg.tpms:
        budget = tpm.get("none") or f"[{tpm.get('budget', 'Budget')}]({tpm_link(tpm)})"
        by = [proc_link(proc, PROCEDURES_PAGE.name) for proc in reg.procedures if tpm["id"] in proc.get("measures", [])]
        rows.append([tpm["id"], tpm["measure"], tpm["unit"], tpm["source"], tpm["threshold"], tpm["goal"], budget,
                     ", ".join(by) or "None yet"])
    out += table(["ID", "Measure", "Unit", "Source", "Threshold", "Goal", "Budget", "Measured by"], rows)
    out += ["", "## Measurements", "",
            "The latest value each TPM measured at each layer, from the runs in the",
            f"[test-run sheet]({PROCEDURES_PAGE.name}#recording-a-run), judged against its threshold",
            "and goal. The website reads the sheet when it builds.", "", TEST_RUNS.format("measurements")]
    out += ["", "## Budgets"]
    for tpm in reg.tpms:
        if not tpm.get("row"):
            continue
        out += ["", f"### {tpm_title(tpm)}", "", f"{tpm.get('budget', 'Budget')}.", ""]
        out += budget_table(tpm)
        if tpm.get("notes"):
            out += [""] + [f"- {note}" for note in tpm["notes"]]
    out += ["", "## What each element carries", "",
            "The TPMs whose budgets name each element. A parent carries what its children carry,",
            "and every element also carries TPM-13 (0 kg).", ""]
    found = carries(reg)
    rows = [[f"{e} {reg.elements[e]['name']}", ", ".join(sorted(found[e], key=tpm_number)) or "None"]
            for e in sorted(reg.elements, key=element_key)]
    out += table(["Element", "TPMs"], rows)
    return "\n".join(out) + "\n"


def block_budgets(reg, stem, options):
    own = {eid for eid, e in reg.elements.items() if e["doc"] == f"{stem}.md"}
    rows = []
    for tpm in reg.tpms:
        for r in tpm.get("row", []):
            mine = [e for e in r.get("elements", []) if e in own]
            if not mine:
                continue
            unit = r.get("unit") or tpm.get("budget_unit", "")
            if tpm.get("cases"):
                budget = ", ".join(f"{number(a)} {unit} in {case}" for a, case in zip(r["amounts"], tpm["cases"]))
            else:
                value = r.get("value", "")
                budget = f"{value} {unit}" if unit and re.fullmatch(r"[≤≥]?[\d.,]+", value) else value
            part = r["part"] + (f" ({r['role']})" if r.get("role") else "")
            rows.append([f"[{tpm['id']}]({tpm_link(tpm, BUDGETS_PAGE.name)})", ", ".join(mine), part, budget])
    if not rows:
        rows = [["None", "", "", ""]]
    return table(["TPM", "Element", "Part", "Budget"], rows)


# ----------------------------------------------------------------------------------------
# End-to-end test procedures and measurements
# ----------------------------------------------------------------------------------------

def proc_link(proc, page=""):
    return f"[{proc['title']}]({page}#{slugify(proc['title'])})"


TEST_RUNS = "<!-- test-runs: {} -->"
SHEET_LAYERS = {layer.lower(): layer for layer in LAYERS}


def checkable(proc):
    """The pass lines a tester can tick: those that are not still [TBD]."""
    return [line for line in proc.get("pass", []) if not line["text"].startswith("[TBD")]


def sheet_labels(reg, proc):
    """The first column of a procedure's tab in the test-run sheet, top to bottom."""
    tpms = {tpm["id"]: tpm for tpm in reg.tpms}
    return (["Layer", "Date"] + [plain(line["text"]) for line in checkable(proc)]
            + [f"{tid} ({tpms[tid]['unit']})" for tid in proc.get("measures", [])] + ["Log", "Notes"])


def parse_tab(reg, proc, rows):
    """(runs, problems) from a procedure's tab, given as CSV rows. A run is a column with a
    layer and a date: {layer, date, passes {line text: ticked}, values {tpm: number}, log, notes}."""
    import datetime
    problems, labels = [], {}
    for row in rows:
        if row and row[0].strip():
            labels[re.sub(r"\s+", " ", row[0]).strip()] = row[1:]
    expected = sheet_labels(reg, proc)
    missing = [label for label in expected if label not in labels]
    extra = [label for label in labels if label not in expected]
    if missing:
        problems.append("the tab has no row for " + "; ".join(f'"{m}"' for m in missing))
    if extra:
        problems.append("the tab has rows the procedure no longer has: " + "; ".join(f'"{e}"' for e in extra))
    width = max((len(cells) for cells in labels.values()), default=0)
    runs = []
    for col in range(width):
        cell = lambda label: (labels.get(label, []) + [""] * width)[col].strip()
        layer, when = cell("Layer"), cell("Date")
        if not layer and not when:
            continue
        date_value = None
        for fmt in ("%Y-%m-%d", "%m/%d/%Y", "%m/%d/%y"):
            try:
                date_value = datetime.datetime.strptime(when, fmt).date()
                break
            except ValueError:
                pass
        if SHEET_LAYERS.get(layer.lower()) is None or date_value is None:
            problems.append(f"run column {col + 2} needs a layer ({', '.join(LAYERS)}) and a date such as "
                            f"2026-12-02, not {layer or 'nothing'!r} and {when or 'nothing'!r}")
            continue
        run = {"layer": SHEET_LAYERS[layer.lower()], "date": date_value, "passes": {}, "values": {},
               "log": cell("Log"), "notes": cell("Notes")}
        for line in checkable(proc):
            run["passes"][line["text"]] = cell(plain(line["text"])).upper() == "TRUE"
        for tid in proc.get("measures", []):
            label = next(label for label in expected if label.startswith(f"{tid} ("))
            text = cell(label).replace(",", "")
            if text:
                try:
                    run["values"][tid] = float(text)
                except ValueError:
                    problems.append(f"run column {col + 2}: {tid} must be a number, not {text!r}")
        runs.append(run)
    return runs, problems


def run_result(proc, run):
    lines = checkable(proc)
    ticked = sum(run["passes"].get(line["text"], False) for line in lines)
    return "Pass" if ticked == len(lines) else f"{ticked} of {len(lines)} pass lines"


def measurements(reg, runs):
    """{tpm id: {layer: (date, value, procedure)}}: the latest measurement at each layer."""
    found = {}
    for proc in reg.procedures:
        for run in runs.get(proc["id"], []):
            for tid, value in run["values"].items():
                layers = found.setdefault(tid, {})
                if run["layer"] not in layers or run["date"] >= layers[run["layer"]][0]:
                    layers[run["layer"]] = (run["date"], value, proc)
    return found


def judge(tpm, value):
    """How a measured value compares with the TPM's threshold and goal."""
    better, goal, threshold = tpm.get("better"), tpm.get("goal_value"), tpm.get("threshold_value")
    if better not in ("lower", "higher"):
        return "not judged: the TPM has no numbers to compare with"
    fits = (lambda limit: value <= limit) if better == "lower" else (lambda limit: value >= limit)
    if goal is not None and fits(goal):
        return "meets the goal"
    if threshold is not None and fits(threshold):
        return "meets the threshold, not the goal"
    return "misses the threshold" if threshold is not None else "misses the goal"


def fill_test_runs(reg, markdown, runs, problems, note=""):
    """The page with each test-runs marker replaced by tables of the runs read from the sheet.
    runs: {procedure id: [run]}; problems: {procedure id: [text]}; note: why there are none."""
    tpms = {tpm["id"]: tpm for tpm in reg.tpms}
    procs = {proc["id"]: proc for proc in reg.procedures}

    def summary():
        rows = []
        for proc in reg.procedures:
            latest = {}
            for run in runs.get(proc["id"], []):
                if run["layer"] not in latest or run["date"] >= latest[run["layer"]]["date"]:
                    latest[run["layer"]] = run
            rows.append([proc_link(proc), *[f"{run_result(proc, latest[l])}, {latest[l]['date'].isoformat()}"
                                            if l in latest else "Not run" for l in LAYERS]])
        return table(["Procedure", *LAYERS], rows)

    def one(proc):
        out = [f"> **The sheet's tab:** {p}." for p in problems.get(proc["id"], [])]
        found = sorted(runs.get(proc["id"], []), key=lambda r: (r["date"], LAYERS.index(r["layer"])))
        if not found:
            return out + (["", "None yet."] if out else ["None yet."])
        rows = []
        for run in found:
            got = ", ".join(f"{tid} {number(v)} {tpms[tid]['unit']}" for tid, v in run["values"].items())
            rows.append([run["date"].isoformat(), run["layer"], run_result(proc, run), got or "None",
                         run["log"] or "None", run["notes"]])
        return out + ([""] if out else []) + table(["Date", "Layer", "Result", "Measured", "Log", "Notes"], rows)

    def measured():
        found = measurements(reg, runs)
        rows = []
        for tpm in reg.tpms:
            if tpm.get("none"):
                continue
            cells = []
            for layer in LAYERS:
                got = found.get(tpm["id"], {}).get(layer)
                cells.append(f"{number(got[1])} {tpm['unit']}, {got[0].isoformat()}: {judge(tpm, got[1])}"
                             if got else "Not measured")
            rows.append([tpm["id"], *cells])
        return table(["TPM", *LAYERS], rows)

    def replace(match):
        what = match.group(1)
        if note:
            return f"> {note}"
        if what == "summary":
            body = summary()
        elif what == "measurements":
            body = measured()
        elif what in procs:
            body = one(procs[what])
        else:
            return match.group(0)
        return "\n".join(body)

    return re.sub(r"<!-- test-runs: ([\w-]+) -->", replace, markdown)


def proc_link(proc, page=""):
    return f"[{proc['title']}]({page}#{slugify(proc['title'])})"


def render_procedures_page(reg):
    tpms = {tpm["id"]: tpm for tpm in reg.tpms}
    sheet = (reg.sheet or {}).get("edit_url", "")
    out = [
        "# End-to-end test procedures",
        "",
        "Each procedure follows one thing the robot does through every node it crosses, from",
        "the operator or the hardware to the motors. Each step names the node that acts, the",
        "interface it uses, and the budget it spends, and the pass lines come from the",
        "[performance budgets](performance-budgets.md) and the design docs' requirements.",
        "",
        "- **Before anything runs, the design review walks each procedure on paper,** with",
        "  whoever works on each step explaining it. A step nobody can explain, or a name still",
        "  `[TBD]`, is a gap to settle.",
        "- **Then each one runs at Sim, Bench, and Robot,** as [Testing layers](testing-layers.md)",
        "  describes, and each run is recorded in the test-run sheet.",
        "",
        "This page is generated from `docs/design/end-to-end-tests.toml` by",
        "`scripts/design render`. The results come from the test-run sheet when the website builds.",
        "",
        "## Recording a run",
        "",
        (f"Open the procedure's tab in the [test-run sheet]({sheet}). " if sheet else
         "Open the procedure's tab in the test-run sheet [TBD: the sheet's address, end-to-end-tests.toml]. ")
        + "In the first empty column, write the layer (Sim, Bench, or Robot) and the date, such as "
        "2026-12-02. Tick each pass line the run met, type each value it measured, and link the log. "
        "Leave the first column alone: it must match each procedure's pass lines here, and the "
        "website flags any row that drifts. `scripts/design sheet` prints the first column for "
        "every procedure, for a new tab.",
        "",
        "## Results",
        "",
        "The latest run of each procedure at each layer. A run passes when every pass line is",
        "ticked.",
        "",
        TEST_RUNS.format("summary"),
    ]
    for proc in reg.procedures:
        out += ["", f"## {proc['title']}", "", proc["purpose"]]
        if proc.get("measures"):
            links = ", ".join(f"[{tid}]({tpm_link(tpms[tid], BUDGETS_PAGE.name)})" for tid in proc["measures"])
            out += ["", f"**Measures:** {links}."]
        rows = []
        for n, step in enumerate(proc.get("step", []), 1):
            node = reg.nodes.get(step.get("node"))
            if node and step.get("actor"):
                who = f"{step['actor']}, through the {node['name']}"
            else:
                who = node["name"] if node else step.get("actor", "")
            iface = reg.interfaces.get(step.get("interface"))
            budget = step.get("budget")
            rows.append([str(n), who, step["does"], code(iface["name"]) if iface else "",
                         f"[{budget}]({tpm_link(tpms[budget], BUDGETS_PAGE.name)})" if budget else ""])
        out += [""] + table(["Step", "Who", "What happens", "Interface", "Budget"], rows)
        if proc.get("pass"):
            out += ["", "**It passes when:**", ""]
            for line in proc["pass"]:
                text = line["text"]
                if line.get("tpm"):
                    text = f"{text.rstrip('.')} ({line['tpm']})."
                out.append(f"- {text}")
        tab = f"{sheet}#gid={proc['sheet_gid']}" if sheet and "sheet_gid" in proc else ""
        out += ["", f"**Runs,** from [its tab in the test-run sheet]({tab}):" if tab else
                "**Runs,** from its tab in the test-run sheet [TBD: the tab, end-to-end-tests.toml]:", "",
                TEST_RUNS.format(proc["id"])]
    return "\n".join(out) + "\n"


def block_fields(reg, stem, options):
    out = table(["Entry", "Where it goes", "What it is"],
                [[f"`[[{name}]]`", where, what] for name, ((where, what), _) in SCHEMA.items()])
    rows = []
    for name, (_, entries) in SCHEMA.items():
        for field, required, holds in entries:
            rows.append([f"`[[{name}]]`", f"`{field}`", "Yes" if required else "No", holds])
    return out + [""] + table(["Entry", "Field", "Required", "What it holds"], rows)


def block_blocks(reg, stem, options):
    rows = [[f"`<!-- design: {kind} -->`", ", ".join(f"`{o}`" for o in opts) or "None", shows]
            for kind, (opts, shows) in BLOCK_HELP.items()]
    return table(["Block", "Options", "What it shows"], rows)


RENDERERS = {"elements": block_elements, "graph": block_graph, "nodes": block_nodes,
             "interfaces": block_interfaces, "questions": block_questions, "budgets": block_budgets,
             "fields": block_fields, "blocks": block_blocks}


def render_doc(problems, reg, path, text):
    """The doc with every block between markers rewritten from the registries."""
    stem = path.stem
    out, pos = [], 0
    # A marker shown as an example, in code, is not a block.
    for match in START.finditer(blank_code(text)):
        kind, options = match.group(1), match.group(2).split()
        where = f"{path.relative_to(REPO)}"
        end = text.find(END, match.end())
        if end < 0:
            problems.error(f"{where}: the design: {kind} block has no {END} after it")
            return text
        if kind not in BLOCKS:
            problems.error(f"{where}: no block called {kind!r}; use {', '.join(BLOCKS)}")
            return text
        for option in options:
            if option not in BLOCKS[kind]:
                problems.error(f"{where}: the {kind} block takes no option {option!r}")
                return text
        if kind in OWN_REGISTRY and not (DESIGN / f"{stem}.toml").exists():
            problems.error(f"{where} has a design: {kind} block but no {stem}.toml beside it")
            return text
        if kind in ("elements", "graph"):
            note = "generated from docs/design/*.toml by scripts/design render: edit those files, not this block"
        elif kind in ("fields", "blocks"):
            note = "generated from scripts/design by scripts/design render: edit the script, not this table"
        else:
            note = NOTE.format(registry=f"{stem}.toml")
        start = f"<!-- design: {kind}{''.join(' ' + o for o in options)} ({note}) -->"
        body = RENDERERS[kind](reg, stem, options)
        out.append(text[pos:match.start()])
        out.append("\n".join([start, "", *body, "", END]))
        pos = end + len(END)
    out.append(text[pos:])
    return "".join(out)


# ----------------------------------------------------------------------------------------
# Generated pages
# ----------------------------------------------------------------------------------------

def render_interfaces_page(reg):
    out = [
        "# Interfaces",
        "",
        "Every node and every topic, service, and action in the robot software, as the design",
        "docs' registries define them. Each one is defined in exactly one design doc's registry,",
        "beside the node that publishes or serves it, and that doc owns it. To change one, edit",
        "that registry and run `scripts/design render`; see",
        "[Registries](README.md#registries). The [system design](system.md#2-nodes) draws them",
        "as a graph.",
        "",
        "This page is generated from `docs/design/*.toml` by `scripts/design render`.",
        "",
        "## Nodes",
        "",
    ]
    rows = [[n["name"], element_label(reg, n["element"]), n["runs_on"], doc_link(reg.doc_of(n), reg=reg), n["does"]]
            for n in reg.nodes.values()]
    out += table(["Node", "Element", "Runs on", "Design doc", "What it does"], rows)
    out += ["", "## Topics, services, and actions", ""]
    out += table(INTERFACE_HEADER + ["Defined in"], interface_rows(reg, reg.interfaces.values(), defined_in=True))
    notes = [i for i in reg.interfaces.values() if i.get("note")]
    if notes:
        out += ["", "### Notes", ""]
        out += [f"- {code(i['name'])}: {i['note']}" for i in notes]
    return "\n".join(out) + "\n"


def slugify(text):
    """The anchor MkDocs gives a heading (Python-Markdown's toc extension)."""
    text = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)
    text = re.sub(r"[`*_]", "", text)
    text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
    text = re.sub(r"[^\w\s-]", "", text).strip().lower()
    return re.sub(r"[-\s]+", "-", text)


def blank(match):
    return re.sub(r"[^\n]", " ", match.group(0))


def blank_code(text):
    """The text with code blocks and code spans blanked out, keeping positions."""
    text = re.sub(r"^(```|~~~).*?^\1[^\n]*$", blank, text, flags=re.S | re.M)
    return re.sub(r"(`+)[^`\n]*?\1", blank, text)


def mask(text):
    """The text with code, comments, and generated blocks blanked out, keeping positions."""
    text = blank_code(text)
    text = re.sub(r"<!-- design: .*?" + re.escape(END), blank, text, flags=re.S)
    return re.sub(r"<!--.*?-->", blank, text, flags=re.S)


def headings(text, masked):
    """(position, anchor, title) for each heading, with MkDocs's numbering of repeats."""
    found, seen = [], {}
    for match in re.finditer(r"^(#{1,6}) (.+)$", masked, flags=re.M):
        title = text[match.start(2):match.end(2)].strip()
        anchor = slugify(title)
        if anchor in seen:
            seen[anchor] += 1
            anchor = f"{anchor}_{seen[anchor]}"
        else:
            seen[anchor] = 0
        found.append((match.start(), anchor, re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", title)))
    return found


def plain(text):
    text = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)
    return re.sub(r"\s+", " ", text).replace("|", "/").strip()


def markers(path):
    """Each [TBD] or [TBR] in a doc's own text: (heading anchor, heading, kind, text)."""
    text = path.read_text(encoding="utf-8")
    masked = mask(text)
    heads = headings(text, masked)
    found = []
    for match in re.finditer(r"\[(TBD|TBR)(?=[:\]])", masked):
        depth, end = 0, None
        for k in range(match.start(), len(masked)):
            if masked[k] == "[":
                depth += 1
            elif masked[k] == "]":
                depth -= 1
                if depth == 0:
                    end = k
                    break
            elif masked[k] == "\n" and masked[k + 1:k + 2] == "\n":
                break
        if end is None:
            continue
        kind = match.group(1)
        inner = text[match.end():end].lstrip(":").strip()
        if not inner:
            line_start = text.rfind("\n", 0, match.start()) + 1
            line_end = text.find("\n", match.end())
            line = text[line_start:line_end]
            if line.lstrip().startswith("|"):
                cells = line.split("|")
                col = text[line_start:match.start()].count("|")
                cell = cells[col].replace(f"[{kind}]", "").strip() if col < len(cells) else ""
                below = text[line_end + 1:text.find("\n", line_end + 1)]
                is_header = re.fullmatch(r"\s*\|(\s*:?-+:?\s*\|)+\s*", below or "") is not None
                inner = f"every value in the {plain(cell)} column" if is_header else plain(cell)
            else:
                inner = plain(line.replace(f"[{kind}]", ""))
        anchor, title = "", path.stem
        for pos, a, t in heads:
            if pos <= match.start():
                anchor, title = a, t
        found.append((anchor, title, kind, plain(inner)))
    return found


def registry_markers(reg):
    """Each registry value that holds a marker, once: (doc stem, entry, field, text)."""
    found = []
    for kind, store in (("element", reg.elements), ("node", reg.nodes), ("interface", reg.interfaces)):
        for e in store.values():
            for key, value in e.items():
                for v in value if isinstance(value, list) else [value]:
                    if isinstance(v, str) and re.search(r"\[(TBD|TBR)\b", v):
                        found.append((reg.doc_of(e), f"{kind} {e.get('id')}", key, plain(v)))
    for tpm in reg.tpms:
        fields = [(key, v) for key, v in tpm.items() if key not in ("row", "notes")]
        fields += [("note", note) for note in tpm.get("notes", [])]
        fields += [(f"row \"{plain(r['part'])}\": {key}", v) for r in tpm.get("row", []) for key, v in r.items()]
        for key, v in fields:
            if isinstance(v, str) and re.search(r"\[(TBD|TBR)\b", v):
                found.append((reg.doc_of(tpm), tpm["id"], key, plain(v)))
    for proc in reg.procedures:
        fields = [(key, v) for key, v in proc.items() if key not in ("step", "pass")]
        fields += [(f"step {n}", s["does"]) for n, s in enumerate(proc.get("step", []), 1)]
        fields += [(f"pass {n}", line["text"]) for n, line in enumerate(proc.get("pass", []), 1)]
        for key, v in fields:
            if isinstance(v, str) and re.search(r"\[(TBD|TBR)\b", v):
                found.append((reg.doc_of(proc), f"procedure {proc['id']}", key, plain(v)))
    return found


def render_open_items_page(reg):
    out = [
        "# Open items",
        "",
        "Everything in the docs that is not settled yet, in one place: each design doc's open",
        "questions, then every marked passage. The markers are explained in",
        "[Mark what is not settled](../writing-docs.md#mark-what-is-not-settled). Who works on",
        "an item, and by when, is in Turgor; where a question has a Turgor deliverable, its",
        "number is given.",
        "",
        "To change an item, edit the doc or registry it comes from, then run",
        "`scripts/design render`. This page is generated from the docs and `docs/design/*.toml`",
        "by `scripts/design render`.",
        "",
        "## Open questions",
    ]
    total = 0
    for stem in sorted(reg.questions, key=lambda s: doc_sort_key(Path(s))):
        # Links are dropped here, so a source cited in a question is cited only by its doc.
        rows = [[f"{q['number']}. {plain(q['text'])}", ", ".join(q.get("turgor", [])) or "None"]
                for q in reg.questions[stem] if q["status"] == "open"]
        if not rows:
            continue
        total += len(rows)
        md = DESIGN / f"{stem}.md"
        if md.exists():
            text = md.read_text(encoding="utf-8")
            at = text.find("<!-- design: questions")
            anchor = ""
            for pos, a, _ in headings(text, mask(text)):
                if 0 <= at and pos < at:
                    anchor = a
            out += ["", f"### [{doc_title(md)}]({md.name}{'#' + anchor if anchor else ''})", ""]
        else:
            out += ["", f"### {doc_link(stem, reg=reg)}", ""]
        out += table(["Question", "Turgor"], rows)
    if not total:
        out += ["", "None."]

    out += ["", "## Marked in the registries", "",
            "Values in the design registries that are not settled yet. They show in every table",
            "that uses them; each is listed here once."]
    by_doc = {}
    for stem, entry, field, text in registry_markers(reg):
        by_doc.setdefault(stem, []).append([entry, field, text])
    for stem in sorted(by_doc, key=lambda s: doc_sort_key(Path(s))):
        out += ["", f"### `{stem}.toml`", ""]
        out += table(["Entry", "Field", "Value"], by_doc[stem])

    out += ["", "## Marked in the docs", "",
            "Every `[TBD]` and `[TBR]` in the docs' own text, by page and section."]
    pages = sorted(p for p in DOCS.rglob("*.md") if p not in GENERATED_PAGES and p not in EXAMPLE_PAGES)
    pages.sort(key=lambda p: (p.parent != DESIGN, doc_sort_key(p) if p.parent == DESIGN else (0, str(p))))
    for page in pages:
        found = markers(page)
        if not found:
            continue
        link = (Path("..", page.relative_to(DOCS)) if page.parent != DESIGN else Path(page.name)).as_posix()
        out += ["", f"### [{doc_title(page)}]({link})", ""]
        rows = [[f"[{title}]({link}#{anchor})" if anchor else title, f"[{kind}: {text}]"]
                for anchor, title, kind, text in found]
        out += table(["Section", "Marked"], rows)
    return "\n".join(out) + "\n"


# ----------------------------------------------------------------------------------------
# Commands
# ----------------------------------------------------------------------------------------

# The open items page reads the other pages' sources, so it is written last.
PAGES = ((INTERFACES_PAGE, render_interfaces_page), (BUDGETS_PAGE, render_budgets_page),
         (PROCEDURES_PAGE, render_procedures_page), (OPEN_ITEMS_PAGE, render_open_items_page))

def outputs(problems, reg):
    """{path: text} for every file render would write."""
    result = {}
    for path in sorted(DESIGN.glob("*.md")):
        # The template's markers are copied into each new doc, which then has a registry.
        if path in GENERATED_PAGES or path == TEMPLATE:
            continue
        text = path.read_text(encoding="utf-8")
        if "<!-- design:" in text:
            result[path] = render_doc(problems, reg, path, text)
    # The pages read the docs, so they come after the docs' blocks are written.
    return result


def cmd_render(_args):
    problems = Problems()
    reg = load(problems)
    if not problems.errors:
        validate(problems, reg)
    if problems.errors:
        return problems.report()
    written = []
    for path, text in outputs(problems, reg).items():
        if path.read_text(encoding="utf-8") != text:
            path.write_text(text, encoding="utf-8")
            written.append(path)
    for path, render in PAGES:
        text = render(reg)
        if not path.exists() or path.read_text(encoding="utf-8") != text:
            path.write_text(text, encoding="utf-8")
            written.append(path)
    for path in written:
        print(f"Wrote {path.relative_to(REPO)}")
    print(f"{len(reg.elements)} elements, {len(reg.nodes)} nodes, {len(reg.interfaces)} interfaces, "
          f"{sum(len(q) for q in reg.questions.values())} questions; {len(written)} files changed.")
    return problems.report()


def cmd_check(_args):
    problems = Problems()
    reg = load(problems)
    if not problems.errors:
        validate(problems, reg)
    if not problems.errors:
        for path, text in outputs(problems, reg).items():
            if path.read_text(encoding="utf-8") != text:
                problems.error(f"{path.relative_to(REPO)} has a generated table that is out of date: "
                               "run scripts/design render")
        for path, render in PAGES:
            if not path.exists() or path.read_text(encoding="utf-8") != render(reg):
                problems.error(f"{path.relative_to(REPO)} is out of date: run scripts/design render")
    if not problems.errors:
        print(f"OK: {len(reg.elements)} elements, {len(reg.nodes)} nodes, {len(reg.interfaces)} interfaces, "
              f"{sum(len(q) for q in reg.questions.values())} questions, {len(reg.tpms)} TPMs, "
              f"{len(reg.procedures)} test procedures; "
              "every generated table is up to date.")
    return problems.report()


def cmd_sheet(_args):
    problems = Problems()
    reg = load(problems)
    if not problems.errors:
        validate(problems, reg)
    if problems.errors:
        return problems.report()
    for proc in reg.procedures:
        gid = proc.get("sheet_gid", "no tab yet")
        print(f"# {proc['title']} (tab gid {gid})")
        print("\n".join(sheet_labels(reg, proc)))
        print()
    return problems.report()


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0],
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("render", help="Rewrite every generated table and page.").set_defaults(run=cmd_render)
    commands.add_parser("check", help="Check the registries and that everything generated is current.").set_defaults(run=cmd_check)
    commands.add_parser("sheet", help="Print each procedure's first column for the test-run sheet.").set_defaults(run=cmd_sheet)
    args = parser.parse_args()
    return args.run(args)


if __name__ == "__main__":
    sys.exit(main())
