    ("id", False, "The key other nodes use for it when its name is a marker; otherwise its name"),
    ("note", False, "A sentence shown under the table on the Interfaces page"),
]
# Every kind of registry entry: (where it goes, what it is), then its fields as (field,
# required, what it holds). The README's field reference is generated from this.
