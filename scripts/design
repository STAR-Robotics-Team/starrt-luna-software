def block_fields(reg, stem, options):
    out = table(["Entry", "Where it goes", "What it is"],
                [[f"`[[{name}]]`", where, what] for name, ((where, what), _) in SCHEMA.items()])
    rows = []
    for name, (_, entries) in SCHEMA.items():
        for field, required, holds in entries:
            rows.append([f"`[[{name}]]`", f"`{field}`", "Yes" if required else "No", holds])
    return out + [""] + table(["Entry", "Field", "Required", "What it holds"], rows)


def block_blocks(reg, stem, options):
    rows = [[f"`<!-- design: {kind} -->`", ", ".join(f"`{o}`" for o in opts) or "None", shows]
            for kind, (opts, shows) in BLOCK_HELP.items()]
    return table(["Block", "Options", "What it shows"], rows)


RENDERERS = {"elements": block_elements, "graph": block_graph, "nodes": block_nodes,
             "interfaces": block_interfaces, "questions": block_questions, "budgets": block_budgets,
             "fields": block_fields, "blocks": block_blocks}


def render_doc(problems, reg, path, text):
    """The doc with every block between markers rewritten from the registries."""
    stem = path.stem
    out, pos = [], 0
    # A marker shown as an example, in code, is not a block.
    for match in START.finditer(blank_code(text)):
        kind, options = match.group(1), match.group(2).split()
        where = f"{path.relative_to(REPO)}"
        end = text.find(END, match.end())
        if end < 0:
            problems.error(f"{where}: the design: {kind} block has no {END} after it")
            return text
        if kind not in BLOCKS:
            problems.error(f"{where}: no block called {kind!r}; use {', '.join(BLOCKS)}")
            return text
        for option in options:
            if option not in BLOCKS[kind]:
                problems.error(f"{where}: the {kind} block takes no option {option!r}")
                return text
        if kind in OWN_REGISTRY and not (DESIGN / f"{stem}.toml").exists():
            problems.error(f"{where} has a design: {kind} block but no {stem}.toml beside it")
            return text
        if kind in ("elements", "graph"):
            note = "generated from docs/design/*.toml by scripts/design render: edit those files, not this block"
        elif kind in ("fields", "blocks"):
            note = "generated from scripts/design by scripts/design render: edit the script, not this table"
        else:
            note = NOTE.format(registry=f"{stem}.toml")
        start = f"<!-- design: {kind}{''.join(' ' + o for o in options)} ({note}) -->"
        body = RENDERERS[kind](reg, stem, options)
        out.append(text[pos:match.start()])
        out.append("\n".join([start, "", *body, "", END]))
        pos = end + len(END)
    out.append(text[pos:])
    return "".join(out)


