// Dev container for Linux hosts without the VNC desktop: GUI programs open as
// normal windows on your own desktop. Same as ../devcontainer.json otherwise;
// keep the two files in sync.
{
  "name": "STAR Lunabotics: native windows (Linux, no VNC)",
  "build": {
    "dockerfile": "../Dockerfile",
    "target": "dev",
    // Build with the host's network, like the running container. Docker's own
    // networks can overlap campus Wi-Fi addresses and break DNS during builds.
    "options": ["--network=host"]
  },
  // Runs on the host before the container starts: lets programs running as your
  // user, which includes the container's user (same user ID), open windows on
  // your desktop. Lasts until you log out.
  "initializeCommand": "xhost +SI:localuser:$(id -un) > /dev/null 2>&1 || echo 'xhost failed; GUI programs may not open. See docs/gui-tools.md.'",
  "remoteUser": "ubuntu",
  "workspaceMount": "source=${localWorkspaceFolder},target=/ws,type=bind",
  "workspaceFolder": "/ws",
  "runArgs": [
    // Use the host's network, so ROS 2 can reach the robot and CAN adapters, and
    // so GUI programs can reach your desktop's display.
    "--network=host",
    // Lets nodes in the container reach nodes on the host through shared memory.
    "--ipc=host",
    // Lets scripts/can_up.sh and scripts/vcan_up.sh configure CAN interfaces.
    "--cap-add=NET_ADMIN"
  ],
  "containerEnv": {
    "COLCON_DEFAULTS_FILE": "/ws/.devcontainer/colcon-defaults.yaml",
    // Your desktop's display, so GUI programs open as normal windows.
    "DISPLAY": "${localEnv:DISPLAY}",
    // The container cannot use your graphics card, so draw OpenGL with the CPU.
    // Without this, RViz stalls while starting up.
    "LIBGL_ALWAYS_SOFTWARE": "1",
    // ROS 2 only finds nodes on this computer until you change this
    // (see docs/ros-networking.md).
    "ROS_AUTOMATIC_DISCOVERY_RANGE": "LOCALHOST"
  },
  "postCreateCommand": "bash scripts/install_deps.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "bierner.markdown-mermaid"
      ],
      "settings": {
        "C_Cpp.default.compileCommands": "/ws/build/compile_commands.json"
      }
    }
  }
}
