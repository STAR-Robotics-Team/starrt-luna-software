<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ctre_phoenix5_vendor</name>
  <version>0.1.0</version>
  <description>
    Downloads pinned, checksum-verified CTRE Phoenix 5 C++ libraries from CTRE's maven
    repository at build time and exports them as the CMake target ctre_phoenix5_vendor::phoenix5.
  </description>
  <maintainer email="j.vilfort01@gmail.com">Julian V</maintainer>
  <license>Apache-2.0</license>

  <url type="website">https://v5.docs.ctr-electronics.com/</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
