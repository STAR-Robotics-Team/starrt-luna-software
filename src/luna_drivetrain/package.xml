<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>luna_drivetrain</name>
  <version>0.1.0</version>
  <description>Drivetrain control for the STAR Lunabotics rover, using CTRE Phoenix 5 over SocketCAN.</description>
  <maintainer email="j.vilfort01@gmail.com">Julian V</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ctre_phoenix5_vendor</depend>
  <!-- The drive hardware plugin (3.5): a ros2_control system interface. -->
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <!-- What runs the drivetrain (3.3): the controller manager, the stock controllers,
       and the ros2 control command. -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>ros2controlcli</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
